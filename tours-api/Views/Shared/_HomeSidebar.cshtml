@{
    // 共用側欄，首頁跟揪團詳情頁都用這份，避免兩邊各放一份、改一次要改兩次。
    // Model 傳目前作用中的頁面名稱字串（"Home" / "TravelGroups" / "Explore"），決定哪個 nav-item 是 active。
    var active = Model as string ?? "";
}
<aside class="sidebar expanded" id="sidebar">
    <div class="sb-top">
        <div class="brand-mark">
            <img src="~/img/logo.png" alt="" asp-append-version="true" />
        </div>
        <span class="brand-word">LazyTravel</span>
        <button class="toggle-btn" id="toggleBtn" aria-label="展開／收合側欄">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
    </div>

    <nav class="nav-list">
        <a class="nav-item @(active == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7"/><path d="M5 10v9a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1v-9"/></svg><span class="label">首頁</span></a>
        <a class="nav-item @(active == "TravelGroups" ? "active" : "")" asp-controller="TravelGroups" asp-action="Index"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M2 21c0-4 3-6.5 7-6.5s7 2.5 7 6.5"/><circle cx="18" cy="8" r="2.4"/><path d="M22 21c0-2.9-1.7-4.8-4-5.6"/></svg><span class="label">揪團找旅伴</span></a>
        <a class="nav-item @(active == "Explore" ? "active" : "")" asp-controller="Explore" asp-action="Index"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 20l-6-2.4V4.4L9 6.8l6-2.4 6 2.4v13.2L15 22l-6-2.4z"/><path d="M9 6.8v13.2M15 4.4v15.2"/></svg><span class="label">揪團行程分享</span></a>
        <a class="nav-item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7.5-4.6-10-9.3C.4 8.1 2.4 4.5 6 4a5 5 0 016 2.4A5 5 0 0118 4c3.6.5 5.6 4.1 4 7.7C19.5 16.4 12 21 12 21z"/></svg><span class="label">收藏行程</span></a>
        <a class="nav-item"
           asp-controller="Members"
           asp-action="Profile">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg><span class="label">個人中心</span></a>
        <a class="nav-item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 8v.01"/></svg><span class="label">關於我們</span></a>
    </nav>

    <hr class="sb-divider" />

    <div class="sb-bottom">
        <button class="bell-btn" aria-label="通知"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 01-3.4 0"/></svg><span class="label">通知</span><span class="bell-dot"></span></button>
        <div class="me">
            <div class="me-avatar"><svg viewBox="0 0 24 24" fill="#fff"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7z"/></svg></div>
            <span class="me-name">訪客</span>
            <svg class="me-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
        </div>
    </div>
</aside>

<script>
    // Liquid Glass 鏡面光斑：滑鼠移到側欄上時，把座標百分比寫進 --mx/--my，
    // 讓 home.css 裡 .sidebar::after 的 radial-gradient 跟著游標移動。
    (function () {
        var sidebarEl = document.getElementById('sidebar');
        if (!sidebarEl) return;
        sidebarEl.addEventListener('mousemove', function (e) {
            var rect = sidebarEl.getBoundingClientRect();
            var mx = ((e.clientX - rect.left) / rect.width) * 100;
            var my = ((e.clientY - rect.top) / rect.height) * 100;
            sidebarEl.style.setProperty('--mx', mx + '%');
            sidebarEl.style.setProperty('--my', my + '%');
        });
        sidebarEl.addEventListener('mouseleave', function () {
            sidebarEl.style.setProperty('--mx', '28%');
            sidebarEl.style.setProperty('--my', '12%');
        });
    })();
</script>
