@{
    ViewData["Title"] = "個人頁面";
    // 這頁是第一人稱 3D 案頭場景，設計稿固定 1440 × 900，
    // 用 iframe 載入 wwwroot/members/scene.dc.html，外層負責等比縮放置中。
    // 場景左邊的電腦螢幕點下去會跳首頁（scene 內用 window.top 導頁，
    // 所以在 iframe 裡也會換掉整個視窗，不是只換 iframe）。
    // 之後要套整站導覽列，把 Layout = null 拿掉即可（場景本身不含導覽列）。
    Layout = null;

    // 🚧🚧🚧 開發期暫時後門，組長把正式登入（Identity Cookie）接上後要整段刪掉 🚧🚧🚧
    // 登入還沒串上之前，可以用 /Members/Profile?devMemberId=1 假裝自己是某個會員。
    // 這裡把同一個 query string 原封不動轉給 iframe，這樣 scene.dc.html 呼叫
    // /Members/ProfileData 等 API 時才能一起帶上，讓 CurrentMemberAccessor 讀得到
    // （見該類別裡的開發期後門邏輯）。等組長把正式登入接上，瀏覽器會自動帶登入的
    // Cookie，devMemberId 就不會再被用到，下面這個變數、以及併進 sceneSrc 那一段
    // 都要刪掉。
    var devMemberId = Context.Request.Query["devMemberId"].ToString();
    // 🚧🚧🚧 開發期暫時後門結束 🚧🚧🚧

    // ⚠️ 這段不是開發後門、是正式功能，就算組長的登入系統接上了也不要刪：
    // 查看「別人」的主頁時網址帶 ?id=5，代表「頁面上顯示的是會員 5」，
    // 跟「你自己是誰」（devMemberId，將來是登入 Cookie）是分開的兩件事，
    // 一樣要轉給 iframe，scene.dc.html 才能把它一起帶去打 /Members/ProfileData
    // （見 MembersController.ProfileData(int? id) 跟 scene.dc.html 的 viewMember()）。
    var viewId = Context.Request.Query["id"].ToString();
    var openTicket = Context.Request.Query["openTicket"].ToString();
    var ticketOnly = Context.Request.Query["ticketOnly"].ToString();
    // 🐛 補上：TravelGroups 詳情頁「申請加入」現在會帶著 groupId 開這張機票
    // （見 travelgroup-details.js 的 openJoinTicket()），要跟 devMemberId/id/
    // openTicket/ticketOnly 一樣原封不動轉給 iframe，scene.dc.html 才知道「現在
    // 是真的在申請哪個揪團」，確認鈕才能真的送出 /TravelGroups/Join 請求，而不是
    // 只存本地草稿（見 scene.dc.html 裡 submitJoinRequest() 的註解）。
    var groupIdQs = Context.Request.Query["groupId"].ToString();

    // 📌 2026-09 新增：Vue demo小卡（見下面 #vueFriendWidget）用來判斷「現在是不是
    // 在看自己的主頁」。跟 scene.dc.html 判斷 viewingOther 的邏輯對齊：網址沒帶 ?id=
    // 就是看自己主頁，帶了 ?id=5 就是在看別人的主頁（這時候「搜尋陌生人加好友」
    // 這個功能沒有意義，小卡完全不顯示）。這個小卡是獨立於下面 iframe/scene.dc.html
    // 之外、直接掛在這個 Razor 頁面上的浮動元件，不會被 scene.dc.html 那個自訂
    // render引擎的重繪邏輯動到，也完全沒有修改 scene.dc.html 裡任何一行。做法跟
    // 下面「2FA 外掛式功能」同一個精神：外掛疊加、不改 scene.dc.html。
    var isSelfView = string.IsNullOrEmpty(viewId);

    var sceneQs = "";
    if (!string.IsNullOrEmpty(devMemberId)) sceneQs += "devMemberId=" + Uri.EscapeDataString(devMemberId);
    if (!string.IsNullOrEmpty(viewId)) sceneQs += (sceneQs.Length > 0 ? "&" : "") + "id=" + Uri.EscapeDataString(viewId);
    if (!string.IsNullOrEmpty(openTicket)) sceneQs += (sceneQs.Length > 0 ? "&" : "") + "openTicket=" + Uri.EscapeDataString(openTicket);
    if (!string.IsNullOrEmpty(ticketOnly)) sceneQs += (sceneQs.Length > 0 ? "&" : "") + "ticketOnly=" + Uri.EscapeDataString(ticketOnly);
    if (!string.IsNullOrEmpty(groupIdQs)) sceneQs += (sceneQs.Length > 0 ? "&" : "") + "groupId=" + Uri.EscapeDataString(groupIdQs);
    var sceneSrc = "~/members/scene.dc.html" + (sceneQs.Length > 0 ? "?" + sceneQs : "");
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lazy Travel</title>
    <style>
        html, body { margin: 0; height: 100%; background: #0f0c09; overflow: hidden; }
        #sceneFit { position: fixed; inset: 0; display: grid; place-items: center; }
        #sceneFrame {
            width: 1440px; height: 900px; border: 0; display: block;
        }
    </style>
</head>
<body>
    <div id="sceneFit">
        <iframe id="sceneFrame" src="@Url.Content(sceneSrc)" title="會員個人頁面場景"></iframe>
    </div>

    @* 2FA 是外掛式功能：不修改 scene.dc.html，只在載入後由獨立腳本疊加元件。 *@
    <link rel="stylesheet" href="~/css/member-2fa-overlay.css" asp-append-version="true" />
    <script src="~/js/member-2fa-overlay.js" asp-append-version="true" defer></script>

    <script>
        // 等比縮放：設計稿 1440×900 永遠完整顯示，不裁切、不變形。
        // 用 zoom 而不是 transform: scale ——
        // transform: scale 是把已經算好版面的畫面「拉伸」成點陣圖再放大/縮小，
        // 在螢幕不是剛好整數倍、或 Windows 顯示設定不是 100% 縮放時，很容易糊掉。
        // zoom 會讓瀏覽器照縮放後的比例「重新排版＋重新繪製」iframe 內容，
        // 文字和線條都是照新的解析度畫出來，不會糊。
        // （zoom 是 Chrome / Edge / Safari 都支援的標準屬性，Firefox 126+ 也支援了）
        (function () {
            var W = 1440, H = 900, f = document.getElementById('sceneFrame');
            function fit() {
                var s = Math.min(window.innerWidth / W, window.innerHeight / H);
                f.style.zoom = s;
            }
            window.addEventListener('resize', fit);
            fit();
        })();
    </script>

    <!-- 📱 2026-09 新增：Vue demo用的「搜尋好友」浮動小卡，外觀做成手機造型，點一下
         展開/收合。這整塊（含下面的Vue script）是獨立掛在這個Razor頁面上的一份DOM，
         跟上面 iframe 裡的 scene.dc.html 完全是兩份文件、兩棵DOM樹——沒有改
         scene.dc.html 任何一行，也不會被它自訂render引擎的重繪邏輯動到，純粹疊加
         在畫面最上層（跟上面的2FA外掛式功能是同一個做法）。功能是真的：呼叫既有的
         /Members/SearchMembers、/Members/SendFriendRequest、/Members/CsrfToken
         這幾支後端API（跟手帳頁裡「搜尋陌生人」用的是同一套，欄位名稱也對齊
         scene.dc.html 的 strangerList 映射：memberId／name／relationshipStatus／
         city／mbti），用 Vue 3（CDN、不用建置）寫的reactive元件。只有看自己主頁時
         才顯示，看別人主頁時 isSelfView 是false，下面就直接不掛載，什麼都不會出現。

         這個小卡疊在整個瀏覽器視窗右下角（不是疊在1440×900那個場景座標系裡面），
         不管場景怎麼縮放都固定在同一個角落，桌面上原本的機票/手帳/吊牌都不會被
         擋到。原本用純圖示怕不夠明顯，改成「圖示+文字」的膠囊按鈕，並加一圈持續
         擴散的光暈動畫吸引注意力，比較容易在展示時被看到。 -->
    <style>
        @@keyframes ltFriendPulse {
            0%   { box-shadow: 0 6px 14px rgba(20,26,26,.35), 0 0 0 0 rgba(176,154,120,.6); }
            70%  { box-shadow: 0 6px 14px rgba(20,26,26,.35), 0 0 0 16px rgba(176,154,120,0); }
            100% { box-shadow: 0 6px 14px rgba(20,26,26,.35), 0 0 0 0 rgba(176,154,120,0); }
        }
        #vueFriendWidget .lt-friend-fab { animation: ltFriendPulse 2.4s ease-out infinite; }
    </style>
    <div id="vueFriendWidget"></div>

    <script src="https://cdn.jsdelivr.net/npm/vue@3.4.31/dist/vue.global.prod.js"></script>
    <script>
        (function () {
            if (!@Html.Raw(isSelfView ? "true" : "false")) return; // 看別人主頁時不顯示

            // 跟 scene.dc.html 同一招：把網址上的 ?devMemberId= 原封不動帶給後端API，
            // 讓 CurrentMemberAccessor 在開發後門模式下讀得到「現在是誰」。組長把正式
            // 登入接上後，這一小段連同 devQs 一起刪掉即可（屆時瀏覽器會自動帶登入
            // Cookie，不再需要這個查詢字串）。
            var qp = new URLSearchParams(window.location.search);
            var devMemberId = qp.get('devMemberId');
            var devQs = devMemberId ? ('devMemberId=' + encodeURIComponent(devMemberId)) : '';
            function apiUrl(path) {
                return devQs ? (path + (path.indexOf('?') > -1 ? '&' : '?') + devQs) : path;
            }

            var createApp = Vue.createApp;
            createApp({
                data: function () {
                    return { open: false, csrf: '', query: '', results: [], searching: false, busyId: null, showTip: false };
                },
                created: function () {
                    var self = this;
                    fetch(apiUrl('/Members/CsrfToken'))
                        .then(function (res) { return res.json(); })
                        .then(function (data) { self.csrf = (data && data.token) || ''; })
                        .catch(function (err) { console.warn('取得CSRF token失敗：', err); });
                    // 🆕 2026-09：呼應「操作導覽」的小提示——場景本身的導覽是畫在
                    // scene.dc.html的1440×900座標系裡面，沒辦法從裡面精準指到這個
                    // 疊在外層瀏覽器視窗角落的按鈕（座標系不一樣），所以這裡改成
                    // 一個樣式對齊、但完全獨立實作的小紙卡提示，進頁面稍等一下自動
                    // 彈出，點知道了或直接點按鈕開面板都會收掉。
                    setTimeout(function () { self.showTip = true; }, 1200);
                },
                methods: {
                    toggle: function () { this.open = !this.open; if (this.open) this.showTip = false; },
                    dismissTip: function () { this.showTip = false; },
                    onInput: function () {
                        var self = this;
                        clearTimeout(this._t);
                        this._t = setTimeout(function () { self.search(); }, 300);
                    },
                    search: function () {
                        var self = this;
                        var q = this.query.trim();
                        if (!q) { this.results = []; return; }
                        this.searching = true;
                        var myGen = (this._gen = (this._gen || 0) + 1);
                        fetch(apiUrl('/Members/SearchMembers?q=' + encodeURIComponent(q)), { headers: { Accept: 'application/json' } })
                            .then(function (res) {
                                return res.json().catch(function () { return []; }).then(function (data) {
                                    return { ok: res.ok, data: data };
                                });
                            })
                            .then(function (r) {
                                if (myGen !== self._gen) return;
                                if (r.ok) self.results = Array.isArray(r.data) ? r.data : [];
                            })
                            .catch(function (err) { console.warn('搜尋會員失敗：', err); })
                            .finally(function () { if (myGen === self._gen) self.searching = false; });
                    },
                    addFriend: function (member) {
                        var self = this;
                        if (this.busyId) return;
                        this.busyId = member.memberId;
                        fetch(apiUrl('/Members/SendFriendRequest'), {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': this.csrf },
                            body: JSON.stringify({ targetMemberId: member.memberId, message: null }),
                        })
                            .then(function (res) {
                                if (!res.ok) throw new Error('HTTP ' + res.status);
                                member.relationshipStatus = 'PendingSent';
                            })
                            .catch(function (err) { console.warn('送出好友申請失敗：', err); })
                            .finally(function () { self.busyId = null; });
                    },
                    statusLabel: function (s) {
                        if (s === 'Friend') return '已是好友';
                        if (s === 'PendingSent') return '已送出邀請';
                        if (s === 'PendingReceived') return '對方邀你了';
                        return '加好友';
                    },
                    metaText: function (m) {
                        var bits = [m.city, m.mbti].filter(Boolean);
                        return bits.length ? bits.join(' · ') : '旅人';
                    },
                },
                template:
                    '<div>' +
                    '<div v-if="showTip && !open" style="position:fixed;right:22px;bottom:98px;width:196px;z-index:1999;transform:rotate(-1.2deg)">' +
                    '<div style="position:relative;padding:13px 26px 12px 15px;background:linear-gradient(150deg,#fdf8ea,#eee4cf);clip-path:polygon(0.8% 2%,99.2% 0,100% 98%,1.6% 100%);box-shadow:0 10px 22px rgba(20,26,26,.4);font-family:\'Noto Sans TC\',sans-serif">' +
                    '<div v-on:click="dismissTip" style="position:absolute;right:9px;top:8px;font-size:11px;color:#a2957c;cursor:pointer">✕</div>' +
                    '<div style="font-size:12px;line-height:1.7;color:#5b5140">在這裡可以搜尋暱稱、加旅伴！</div>' +
                    '</div>' +
                    '<div style="position:absolute;right:30px;bottom:-6px;width:13px;height:13px;background:#eee4cf;transform:rotate(45deg);box-shadow:2px 2px 4px rgba(20,26,26,.15)"></div>' +
                    '</div>' +
                    '<div v-on:click="toggle" v-if="!open" class="lt-friend-fab" title="搜尋好友" style="position:fixed;right:28px;bottom:28px;display:flex;align-items:center;gap:9px;padding:14px 22px 14px 16px;border-radius:32px;background:linear-gradient(150deg,#fdf8ea,#eee4cf);color:#5b5140;cursor:pointer;z-index:2000;user-select:none;font-family:\'Noto Sans TC\',sans-serif">' +
                    '<span style="font-size:24px;line-height:1">📱</span>' +
                    '<span style="font-size:15px;font-weight:600;letter-spacing:1.5px;white-space:nowrap;color:#5b5140">搜尋好友</span>' +
                    '</div>' +
                    '<div v-if="open" style="position:fixed;right:28px;bottom:96px;width:264px;height:480px;z-index:2001;background:#1b1712;border-radius:30px;padding:10px;box-shadow:0 14px 34px rgba(0,0,0,.5);box-sizing:border-box">' +
                    '<div style="width:100%;height:100%;background:#fffaee;border-radius:22px;overflow:hidden;display:flex;flex-direction:column;font-family:\'Noto Sans TC\',sans-serif">' +
                    '<div style="flex:none;padding:14px 14px 10px;background:#f2e9d8;border-bottom:1px solid #dccdae;display:flex;align-items:center;justify-content:space-between">' +
                    '<div style="font-size:13px;letter-spacing:2px;color:#8f4a20;font-weight:600">搜尋好友</div>' +
                    '<div v-on:click="toggle" style="cursor:pointer;color:#a2917a;font-size:13px">✕</div>' +
                    '</div>' +
                    '<div style="flex:none;padding:10px 12px">' +
                    '<input v-model="query" v-on:input="onInput" placeholder="輸入暱稱搜尋…" style="width:100%;box-sizing:border-box;font-size:13.5px;padding:8px 10px;border:1px solid #cbb99a;background:#fff;border-radius:6px" />' +
                    '</div>' +
                    '<div style="flex:1;overflow:auto;padding:0 10px 12px;display:flex;flex-direction:column;gap:8px">' +
                    '<div v-for="m in results" :key="m.memberId" style="display:flex;align-items:center;gap:8px;padding:8px;background:#fff;border:1px solid #e3d6bd;border-radius:8px">' +
                    '<div style="width:30px;height:30px;flex:none;border-radius:50%;background:#d8c2a4;color:#5b4630;display:flex;align-items:center;justify-content:center;font-size:13px">{{ (m.name || \'?\').slice(0,1) }}</div>' +
                    '<div style="flex:1;min-width:0">' +
                    '<div style="font-size:12.5px;color:#4e4437;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ m.name }}</div>' +
                    '<div style="font-size:10.5px;color:#a2917a">{{ metaText(m) }}</div>' +
                    '</div>' +
                    '<button v-on:click="addFriend(m)" :disabled="busyId === m.memberId || m.relationshipStatus !== \'Stranger\'" style="font-size:10.5px;padding:5px 8px;border:1px solid #b09a78;background:#f6eddb;color:#5b4c39;border-radius:5px;cursor:pointer;white-space:nowrap">{{ statusLabel(m.relationshipStatus) }}</button>' +
                    '</div>' +
                    '<div v-if="!searching && query.trim() && results.length === 0" style="text-align:center;color:#a2917a;font-size:12px;padding:20px 4px">找不到符合的會員</div>' +
                    '<div v-if="searching" style="text-align:center;color:#a2917a;font-size:12px;padding:20px 4px">搜尋中…</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>',
            }).mount('#vueFriendWidget');
        })();
    </script>
</body>
</html>


