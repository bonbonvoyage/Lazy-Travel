@model LazyTravel.ViewModels.TravelGroupIndexViewModel
@{
    ViewData["Title"] = "揪團找旅伴";
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lazy Travel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&family=Noto+Serif+TC:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/travelgroups-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ai-travel-matcher.css" asp-append-version="true" />
</head>
<body class="home-app groups-page">
<div class="app">
    @await Html.PartialAsync("_HomeSidebar", "TravelGroups")
    <main class="main groups-main">
        <div class="groups-shell">
            <header class="groups-heading">
                <p class="groups-eyebrow">Find your travel partner</p>
                <h1>揪團找旅伴</h1>
                <p>找一群步調相近的人，把想去的地方變成一起出發的旅程。</p>
            </header>

            <form class="groups-filter" method="get" asp-action="Index">
                <input type="hidden" name="scope" value="@Model.Scope" />
                <input type="hidden" name="maxDays" value="@Model.MaxDays" />
                <input type="hidden" id="groupStartDate" name="startDate" value="@Model.StartDate" />
                <input type="hidden" id="groupEndDate" name="endDate" value="@Model.EndDate" />

                <div class="filter-control filter-country">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 4 5.8 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.8-4-9s1.5-6.5 4-9Z"/></svg>
                    <label for="groupCountry">國家</label>
                    <div class="country-combobox">
                        <input id="groupCountry" name="country" type="text" value="@Model.Country" placeholder="輸入或選擇國家" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="groupCountryOptions" aria-describedby="countryError" />
                        <button class="country-toggle" type="button" aria-label="展開國家選單" tabindex="-1"><svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg></button>
                    </div>
                    <div id="groupCountryOptions" class="country-options" role="listbox" aria-label="國家" hidden>
                        <div role="option" data-value="" aria-selected="false">所有國家</div>
                        @foreach (var item in Model.AllCountries)
                        {
                            <div role="option" data-value="@item" aria-selected="false">@item</div>
                        }
                        <div class="country-empty" role="status" hidden>沒有符合的國家</div>
                    </div>
                    <div id="countryError" class="country-error" role="status" hidden>請選擇清單中的國家，或清空欄位。</div>
                </div>

                <label class="filter-control filter-control-date" for="groupDateRange">
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
                    <span>行程區間</span>
                    <input id="groupDateRange" type="text" value="@Model.DateRangeText" placeholder="選擇起訖日期" autocomplete="off" readonly />
                </label>

                <button class="filter-submit" type="submit" aria-label="搜尋揪團">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
                </button>
            </form>

            @await Html.PartialAsync("_AiTravelMatcher")

            <section class="groups-board" aria-labelledby="board-title">
                <div class="board-toolbar">
                    <nav class="groups-tabs" aria-label="揪團分類">
                        <a class="@(Model.Scope == "all" ? "active" : "")" asp-action="Index" asp-route-scope="all" asp-route-country="@Model.Country" asp-route-startDate="@Model.StartDate" asp-route-endDate="@Model.EndDate" id="board-title">所有揪團</a>
                        <button type="button" disabled title="登入後即可查看">我的行程</button>
                        <a class="@(Model.Scope == "recommended" ? "active" : "")" asp-action="Index" asp-route-scope="recommended" asp-route-country="@Model.Country" asp-route-startDate="@Model.StartDate" asp-route-endDate="@Model.EndDate">揪團推薦</a>
                    </nav>
                    <a class="create-group" asp-action="Create"><span>＋</span> 新增揪團</a>
                </div>

                @if (Model.Groups.Count == 0)
                {
                    <div class="groups-empty">
                        <div class="empty-icon">⌁</div>
                        <h2>目前沒有符合條件的揪團</h2>
                        <p>換個國家或日期看看，也可以清除條件瀏覽全部。</p>
                        <a asp-action="Index">清除篩選</a>
                    </div>
                }
                else
                {
                    <div class="groups-grid">
                    @foreach (var group in Model.Groups)
                    {
                        <article class="group-card">
                            <a class="card-cover" asp-action="Details" asp-route-id="@group.GroupId" aria-label="查看 @group.Title">
                                @if (!string.IsNullOrWhiteSpace(group.CoverImageUrl))
                                {
                                    <img src="@group.CoverImageUrl" alt="@group.Title" />
                                }
                                else
                                {
                                    <span class="cover-fallback">LazyTravel</span>
                                }
                            </a>
                            <button class="favorite-button" type="button" data-group-id="@group.GroupId" aria-label="@(group.IsFavorited ? "取消收藏" : "收藏") @group.Title" aria-pressed="@group.IsFavorited.ToString().ToLowerInvariant()">
                                <svg viewBox="0 0 24 24"><path d="M12 21s-8-4.8-8-11a4.8 4.8 0 0 1 8-3.5A4.8 4.8 0 0 1 20 10c0 6.2-8 11-8 11Z"/></svg>
                            </button>
                            <div class="card-content">
                                <a class="card-title" asp-action="Details" asp-route-id="@group.GroupId">@group.Title</a>
                                <p class="card-meta"><span>⌖</span> @group.Country@(string.IsNullOrWhiteSpace(group.Region) ? "" : $"・{group.Region}")</p>
                                <p class="card-meta"><span>▣</span> @group.DateText</p>
                                <div class="card-tags">
                                    @foreach (var tag in group.Tags)
                                    {
                                        <span>@tag</span>
                                    }
                                </div>
                                <div class="card-progress"><span>♙</span><strong>@group.CurrentPeople</strong> / @group.MaxPeople 人</div>
                                <div class="group-card-stats" aria-label="揪團互動數據">
                                    <span class="stat-pill stat-favorite @(group.IsFavorited ? "is-active" : "")" title="收藏數" data-group-favorite-stat data-group-id="@group.GroupId"><svg viewBox="0 0 24 24"><path d="M12 21s-8-4.8-8-11a4.8 4.8 0 0 1 8-3.5A4.8 4.8 0 0 1 20 10c0 6.2-8 11-8 11Z"/></svg><strong data-group-favorite-count>@group.FavoriteCount</strong></span>
                                </div>
                                <footer class="card-footer">
                                    <div class="owner-avatar">
                                        @if (!string.IsNullOrWhiteSpace(group.OwnerAvatarUrl))
                                        {
                                            <img src="@group.OwnerAvatarUrl" alt="" />
                                        }
                                        else
                                        {
                                            <span>@group.OwnerName[..1]</span>
                                        }
                                    </div>
                                    <div class="owner-copy">
                                        <strong>@group.OwnerName</strong>
                                        <small>揪團發起人</small>
                                    </div>
                                    <span class="status-badge status-@group.Status">@group.StatusText</span>
                                </footer>
                            </div>
                        </article>
                    }
                    </div>
                }
                @if (Model.Groups.Count < Model.TotalCount)
                {
                    <div class="groups-load-more">
                        <a asp-action="Index" asp-route-take="@(Model.Take + 12)" asp-route-country="@Model.Country" asp-route-startDate="@Model.StartDate" asp-route-endDate="@Model.EndDate" asp-route-scope="@Model.Scope">載入更多</a>
                    </div>
                }
            </section>
        </div>
        <div class="groups-toast" data-groups-toast hidden>
            <span data-toast-message>已加入收藏</span>
            <button type="button" data-toast-undo>復原</button>
        </div>    </main>
</div>

<script src="~/lib/flatpickr/flatpickr.min.js" asp-append-version="true"></script>
<script src="~/js/sidebar.js" asp-append-version="true"></script>
<script src="~/js/travelgroups-index.js" asp-append-version="true"></script>
<script src="~/js/ai-travel-matcher.js" asp-append-version="true"></script>
</body>
</html>



