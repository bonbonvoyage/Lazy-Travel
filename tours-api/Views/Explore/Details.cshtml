@model VlogPost
@{
    ViewData["Title"] = Model.Title;
    var nodes = (List<ItineraryNode>)ViewBag.Nodes;
    var likeCount = (int)ViewBag.LikeCount;
    var favoriteCount = (int)ViewBag.FavoriteCount;
}

<style>
    .post-content { color: var(--ink); line-height: 1.8; }
    .post-content h2 { font-family: var(--font-display); font-size: 1.3rem; color: var(--sea-800); margin-top: 1rem; }
    .post-content h3 { font-family: var(--font-display); font-size: 1.1rem; color: var(--sea-800); margin-top: .8rem; }
    .post-content img { max-width: 100%; border-radius: var(--radius-sm); margin: .5rem 0; }
    .explore-official-badge {
        display: inline-flex; align-items: center; gap: .15rem;
        background-color: var(--coral-600); color: #fff; border-radius: var(--radius-pill);
        font-size: .72rem; font-weight: 500; padding: .1rem .6rem;
    }

    /* 主圖 + 標題疊字，跟參考圖右半邊的呈現方式一致 */
    .detail-hero {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 10;
        background-size: cover;
        background-position: center;
        background-color: var(--sea-800);
        border-radius: var(--radius-lg);
        overflow: hidden;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: flex-end;
    }
    .detail-hero-overlay {
        width: 100%;
        padding: 3rem 1.5rem 1.5rem;
        background: linear-gradient(to top, rgba(15,30,40,.88), rgba(15,30,40,0));
        color: #fff;
    }
    .detail-hero-title { color: #fff; font-family: var(--font-display); margin-bottom: .5rem; }
    .detail-hero-meta {
        font-size: .88rem;
        opacity: .95;
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
    }

    /* 每日行程列表：日期用大圓圈編號，中間用連接線串起每一天，底下是單純堆疊的景點卡片（不再用每站小圓點）。 */
    .day-group { position: relative; padding-left: 3.25rem; padding-bottom: 1.75rem; }
    .day-group:last-child { padding-bottom: 0; }
    .day-badge {
        position: absolute;
        left: 0;
        top: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        background-color: var(--sea-600);
        color: #fff;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.1rem;
        z-index: 2;
    }
    .day-group.has-next-day::before {
        content: '';
        position: absolute;
        left: 1.19rem;
        top: 2.5rem;
        bottom: 0;
        width: 2px;
        background-color: var(--border-soft);
    }
    .itinerary-stop-card {
        border: 1px solid var(--border-soft);
        border-radius: var(--radius-md);
        background-color: var(--surface);
        padding: 1rem;
        margin-bottom: 1rem;
    }
    .itinerary-stop-card:last-child { margin-bottom: 0; }
    .itinerary-stop-title { font-family: var(--font-display); color: var(--sea-700); font-size: 1.05rem; font-weight: 600; }
    .itinerary-stop-time { color: var(--text-muted); font-size: .85rem; }
    .itinerary-stop-image { width: 100%; max-height: 260px; object-fit: cover; border-radius: var(--radius-sm); margin: .75rem 0; }

    /* 底部社交互動列 */
    .social-bar {
        position: sticky;
        bottom: 0;
        background-color: var(--surface);
        border-top: 1px solid var(--border-soft);
        padding: .85rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        border-radius: var(--radius-md) var(--radius-md) 0 0;
        box-shadow: 0 -4px 16px rgba(31, 61, 78, .08);
        margin-top: 2rem;
    }
    .social-bar .social-stat {
        display: flex;
        align-items: center;
        gap: .35rem;
        color: var(--text-secondary);
        font-size: .92rem;
        background: none;
        border: none;
        padding: .25rem .5rem;
        border-radius: var(--radius-pill);
        transition: background-color .15s ease, color .15s ease;
    }
    .social-bar .social-stat:hover { background-color: var(--sea-50); }
    .social-bar .social-stat.active { color: var(--coral-600); font-weight: 600; }
</style>

<div class="container py-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-primary mb-3">← 回行程靈感</a>

    <div class="detail-hero" style="background-image:url('@Model.MediaUrl')">
        <div class="detail-hero-overlay">
            <h1 class="h3 detail-hero-title mb-2">@Model.Title</h1>
            <div class="detail-hero-meta">
                @if (Model.TravelDate is not null)
                {
                    <span>@Model.TravelDate.Value.ToString("yyyy-MM")</span>
                    <span>·</span>
                }
                <span>@Model.TravelDays 天</span>
                <span>·</span>
                <span>@(Model.Member?.Name ?? $"會員 #{Model.MemberId}")</span>
                @if (MemberLookup.IsOfficial(Model.Member))
                {
                    <span class="explore-official-badge">✓ 官方合作</span>
                }
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            @if (!string.IsNullOrWhiteSpace(Model.Content))
            {
                <div class="post-content mb-4">@Html.Raw(Model.Content)</div>
            }

            @if (nodes.Any())
            {
                <h2 class="h5 mt-4 mb-3">🗓️ 每日行程</h2>
                var dayGroupsList = nodes.GroupBy(n => n.DayNumber).OrderBy(g => g.Key).ToList();
                for (var d = 0; d < dayGroupsList.Count; d++)
                {
                    var dayGroup = dayGroupsList[d];
                    var isLastDay = d == dayGroupsList.Count - 1;
                    <div class="day-group @(isLastDay ? "" : "has-next-day")">
                        <div class="day-badge">@dayGroup.Key</div>
                        <div class="fw-medium mb-3">第 @dayGroup.Key 天</div>
                        @foreach (var node in dayGroup)
                        {
                            <div class="itinerary-stop-card">
                                <div class="itinerary-stop-title">@node.LocationName</div>
                                <div class="itinerary-stop-time">
                                    @(node.ArrivalTime?.ToString("HH:mm") ?? "—")@(node.DepartureTime is not null ? " - " + node.DepartureTime.Value.ToString("HH:mm") : "")
                                    @{ var stayLabel = node.StayTime.ToStayLabel(); }
                                    @if (!string.IsNullOrWhiteSpace(stayLabel))
                                    {
                                        <text>（停留 @stayLabel）</text>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(node.MediaUrl))
                                {
                                    <img src="@node.MediaUrl" alt="" class="itinerary-stop-image" />
                                }
                                @if (!string.IsNullOrWhiteSpace(node.Description))
                                {
                                    <p class="text-secondary mb-1">@node.Description</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(node.Remarks))
                                {
                                    <p class="text-muted small mb-0">備註：@node.Remarks</p>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>

        <div class="col-lg-4">
            <div class="card p-3">
                <dl class="row small mb-0">
                    <dt class="col-5 text-muted">目的地</dt><dd class="col-7">@Model.Destination</dd>
                    <dt class="col-5 text-muted">天數</dt><dd class="col-7">@Model.TravelDays 天</dd>
                    <dt class="col-5 text-muted">出遊日期</dt><dd class="col-7">@(Model.TravelDate?.ToString("yyyy/MM/dd") ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>

    @* ---------- 底部互動列：只留讚/收藏(真實資料，點下去會真的加減)，不放分享跟留言 ---------- *@
    <div class="social-bar">
        <form asp-controller="Explore" asp-action="ToggleLike" asp-route-id="@Model.PostId" method="post" class="d-inline">
            <button type="submit" class="social-stat @(ViewBag.IsLiked ? "active" : "")">
                @(ViewBag.IsLiked ? "❤️" : "🤍") @likeCount
            </button>
        </form>
        <form asp-controller="Explore" asp-action="ToggleFavorite" asp-route-id="@Model.PostId" method="post" class="d-inline">
            <button type="submit" class="social-stat @(ViewBag.IsFavorited ? "active" : "")">
                🔖 @favoriteCount 收藏
            </button>
        </form>
    </div>
</div>
