@model LazyTravel.ViewModels.ExploreDetailsViewModel
@{
    Layout = null;
    var post = Model.Post;
    var author = string.IsNullOrWhiteSpace(post.Member?.Name) ? "旅人" : post.Member.Name;
    var content = Model.PlainContent;
    var cover = Model.Images.FirstOrDefault();
    var days = Model.Nodes.GroupBy(n => n.DayNumber).OrderBy(g => g.Key).ToList();
    var tags = new[] { post.Destination, post.TravelPeople.ToLabel() }.Where(t => !string.IsNullOrWhiteSpace(t)).Distinct().ToList();
    var highlight = string.IsNullOrWhiteSpace(Model.Highlight)
        ? content.Split(new[] { '。', '！', '？', '\n' }, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Trim()
        : Model.Highlight;
    var people = post.TravelPeople.ToLabel();
    var region = string.IsNullOrWhiteSpace(Model.Region) ? "未提供" : Model.Region;
    var isArticleOwner = ViewBag.IsArticleOwner as bool? ?? false;
    var authorProfileUrl = post.MemberId > 0 ? $"/Members/Profile?id={post.MemberId}" : null;
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@post.Title - Lazy Travel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&family=Noto+Serif+TC:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/explore-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/report-modal.css" asp-append-version="true" />
</head>
<body class="home-app article-page">
<div class="app">
    @await Html.PartialAsync("_HomeSidebar", "Explore")
    <main class="main article-main">
        <div class="article-test-switch" aria-label="測試身分切換">
            <span>測試身分</span>
            <button type="button" class="@(isArticleOwner ? "" : "active")" data-article-role="visitor">訪客</button>
            <button type="button" data-article-role="viewer">一般檢視者</button>
            <button type="button" class="@(isArticleOwner ? "active" : "")" data-article-role="author">發文者</button>
        </div>
        <button class="page-back-button article-back" type="button" data-back-fallback="@Url.Action("Index", "Explore")" aria-label="返回上一頁">＜</button>
        @if (Model.IsDraft)
        {
            <section class="article-draft">
                <div><strong>文章草稿</strong><p>這篇文章尚未公開，確認內容後可送出審核。</p></div>
                <form asp-action="Publish" asp-route-id="@post.PostId" method="post"><button class="article-button" type="submit">確認並送出審核</button></form>
            </section>
        }
        else if (post.Status == VlogPostStatus.PendingReview)
        {
            <section class="article-draft"><strong>文章審核中，通過後會公開顯示。</strong></section>
        }
        <div class="article-layout">
            <article class="article-body">
                <header class="article-hero">
                    @if (cover is not null) { <img class="article-cover" src="@cover" alt="@post.Title" /> }
                    <div class="article-actions" data-article-actions>
                        @if (post.Status == VlogPostStatus.Published)
                        {
                            <form asp-action="ToggleFavorite" asp-route-id="@post.PostId" method="post" data-detail-favorite-form data-action-role="reader author">
                                <button class="article-button article-interaction-button @(Model.IsFavorited ? "active" : "")" type="submit" aria-pressed="@Model.IsFavorited.ToString().ToLowerInvariant()" data-detail-favorite-button><svg class="interaction-icon interaction-heart" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-8-4.8-8-11a4.8 4.8 0 0 1 8-3.5A4.8 4.8 0 0 1 20 10c0 6.2-8 11-8 11Z"/></svg><span data-detail-favorite-text>@(Model.IsFavorited ? "已收藏" : "收藏")</span></button>
                            </form>
                            <form asp-action="ToggleLike" asp-route-id="@post.PostId" method="post" data-detail-like-form data-action-role="reader author">
                                <button class="article-button article-interaction-button @(Model.IsLiked ? "active" : "")" type="submit" aria-pressed="@Model.IsLiked.ToString().ToLowerInvariant()" data-detail-like-button><svg class="interaction-icon interaction-like" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 11v10H4V11h3Zm4 10h7.2c.9 0 1.7-.6 1.9-1.5l1.3-5.3A2 2 0 0 0 19.5 12H15V6.8c0-1-.8-1.8-1.8-1.8h-.4L9 12v9h2Z"/></svg><span>按讚</span><strong data-detail-like-count>@Model.LikeCount</strong></button>
                            </form>
                            <button class="article-button" type="button" data-report-open data-report-type="VlogPost" data-report-target-id="@post.PostId" data-report-title="@post.Title" data-action-role="reader">⚑ 檢舉文章</button>
                            <a class="article-button" asp-action="Edit" asp-route-id="@post.PostId" data-action-role="author">✎ 編輯文章</a>
                            <form asp-action="Delete" asp-route-id="@post.PostId" asp-route-viewerMemberId="@post.MemberId" method="post" data-detail-delete-form data-action-role="author">
                                <button class="article-button article-danger-button" type="submit">刪除文章</button>
                            </form>
                        }
                    </div>
                    <div class="article-hero-copy">
                        <h1>@post.Title</h1>
                        <p>@post.Destination</p>
                    </div>
                </header>

                <section class="article-panel article-facts" aria-label="行程資訊">
                    <div><span class="fact-icon">◎</span><div><small>國家／目的地</small><strong>@post.Destination</strong></div></div>
                    <div><span class="fact-icon">⌖</span><div><small>地區</small><strong>@region</strong></div></div>
                    <div><span class="fact-icon">▦</span><div><small>旅遊日期</small><strong>@(post.TravelDate.HasValue ? $"{post.TravelDate:yyyy/MM/dd} – {post.TravelDate.Value.AddDays(Math.Max(1,post.TravelDays)-1):yyyy/MM/dd}" : "未提供")</strong></div></div>
                    <div><span class="fact-icon">♙</span><div><small>同行人數</small><strong>@people</strong></div></div>
                    <div class="article-tags"><span>標籤</span>@foreach (var tag in tags) { <span class="article-tag">@tag</span> }</div>
                </section>

                <section class="article-panel article-intro">
                    <h2><span>❧</span> 旅程前言</h2>
                    <div class="article-prose">@(string.IsNullOrWhiteSpace(content) ? "作者尚未補充旅程前言。" : content)</div>
                </section>
                <section class="article-panel article-highlight">
                    <span class="quote-mark" aria-hidden="true">“</span><h2>一句話亮點</h2>
                    <p>@(string.IsNullOrWhiteSpace(highlight) ? "作者尚未補充旅程亮點。" : highlight)</p>
                </section>
                <section class="article-panel article-days">
                    <h2><span>▦</span> 每日行程與分享</h2>
                    @if (days.Count == 0) { <p class="article-muted">尚未提供每日行程。</p> }
                    @foreach (var day in days)
                    {
                        <details class="article-day" open>
                            <summary><span class="day-number">@day.Key</span><strong>DAY @day.Key</strong><span class="day-route">@string.Join(" · ", day.Where(n => !n.ArrivalTime.HasValue).Select(n => n.LocationName).Where(n => !string.IsNullOrWhiteSpace(n)))</span><span class="day-chevron">⌄</span></summary>
                            <div class="day-stops">
                                <div class="day-periods">
                                @foreach (var period in new[] { "上午", "下午", "晚上" })
                                {
                                    var stops = day.Where(n => (n.ArrivalTime?.Hour < 12 ? "上午" : n.ArrivalTime?.Hour < 18 ? "下午" : n.ArrivalTime.HasValue ? "晚上" : "") == period).ToList();
                                    <div class="day-period"><span class="period-label">@period</span><div>
                                    @if (stops.Count == 0) { <span class="article-muted">未安排</span> }
                                    @foreach (var stop in stops) { <span class="period-stop">@stop.LocationName</span> }
                                    </div></div>
                                }
                                </div>
                                @foreach (var stop in day.Where(n => !string.IsNullOrWhiteSpace(n.Description)))
                                { <p class="day-note"><strong>心得分享 · @stop.LocationName：</strong>@stop.Description</p> }
                                @foreach (var stop in day.Where(n => !string.IsNullOrWhiteSpace(n.Remarks)))
                                { <p class="day-note"><strong>行程筆記：</strong>@stop.Remarks</p> }
                            </div>
                        </details>
                    }
                </section>
            </article>
            <aside class="article-side">
                <section class="article-panel author-panel">
                    <div class="author-heading">
                        @if (!string.IsNullOrWhiteSpace(authorProfileUrl))
                        {
                            <a class="author-profile-link" href="@authorProfileUrl" aria-label="前往 @author 的個人中心">
                                <span class="author-avatar">
                                    @if (!string.IsNullOrWhiteSpace(post.Member?.AvatarUrl)) { <img src="@post.Member.AvatarUrl" alt="@author 的頭像" /> }
                                    else { <span>@author[..1]</span> }
                                </span>
                                <strong>@author</strong>
                            </a>
                        }
                        else
                        {
                            <span class="author-avatar">
                                @if (!string.IsNullOrWhiteSpace(post.Member?.AvatarUrl)) { <img src="@post.Member.AvatarUrl" alt="@author 的頭像" /> }
                                else { <span>@author[..1]</span> }
                            </span>
                            <strong>@author</strong>
                        }
                    </div>
                    <p class="author-bio">@(string.IsNullOrWhiteSpace(post.Member?.Bio) ? "這位旅人尚未填寫個人簡介。" : post.Member.Bio)</p>
                    <dl class="author-stats">
                        <div><dt>⌖ 所在地</dt><dd>@(string.IsNullOrWhiteSpace(post.Member?.City) ? "未提供" : post.Member.City)</dd></div>
                        <div><dt>▦ 加入時間</dt><dd>@(post.Member?.CreatedAt.ToString("yyyy/MM") ?? "未提供")</dd></div>
                        <div><dt>♧ 已發布文章</dt><dd>@Model.PublishedCount 篇</dd></div>
                        <div><dt>✓ 已完成行程</dt><dd>@Model.CompletedCount 趟</dd></div>
                    </dl>
                </section>
                <section class="article-panel article-gallery" aria-label="旅程照片">
                    <h2>旅程相簿 <small>@Model.Images.Count 張</small></h2>
                    <div class="article-photo-grid">
                    @for (var i = 0; i < Math.Min(6, Model.Images.Count); i++)
                    {
                        <button type="button" class="article-photo" data-photo-index="@i" aria-label="@(i == 5 && Model.Images.Count > 6 ? $"更多圖片，共 {Model.Images.Count} 張" : $"查看第 {i+1} 張照片")">
                            <img src="@Model.Images[i]" alt="旅程照片 @(i+1)" loading="lazy" />
                            @if (i == 5 && Model.Images.Count > 6) { <span class="more-photos">＋更多圖片</span> }
                        </button>
                    }
                    </div>
                    @if (Model.Images.Count == 0) { <p class="article-muted">尚未提供旅程照片。</p> }
                </section>
            </aside>
        </div>
        <dialog class="photo-dialog" aria-label="旅程相簿">
            <button class="photo-close" type="button" aria-label="關閉相簿">×</button>
            <button class="photo-prev" type="button" aria-label="上一張">‹</button>
            <figure><img id="photoFull" alt="" /><figcaption id="photoCounter" aria-live="polite"></figcaption></figure>
            <button class="photo-next" type="button" aria-label="下一張">›</button>
        </dialog>
    </main>
</div>
<script id="articlePhotos" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Images))</script>
<script src="~/js/sidebar.js" asp-append-version="true"></script>
<script src="~/js/report-modal.js" asp-append-version="true"></script>
<script src="~/js/explore-details.js" asp-append-version="true"></script>
</body>
</html>







