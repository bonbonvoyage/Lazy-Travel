@model LazyTravel.ViewModels.ExploreEditorViewModel
@{
    Layout = null;
    var post = Model.Post;
    var country = post.Destination;
    var region = Model.Region;
    var people = post.TravelPeople.ToLabel();
    var startDate = post.TravelDate?.ToString("yyyy-MM-dd") ?? "";
    var endDate = post.TravelDate?.AddDays(Math.Max(1, post.TravelDays) - 1).ToString("yyyy-MM-dd") ?? "";
    var days = Model.Nodes
        .GroupBy(n => n.DayNumber)
        .OrderBy(g => g.Key)
        .Select(g => new
        {
            Day = g.Key,
            Title = string.Join("、", g.Where(n => !n.ArrivalTime.HasValue).Select(n => n.LocationName).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct()),
            Morning = string.Join("\n", g.Where(n => n.ArrivalTime.HasValue && n.ArrivalTime.Value.Hour < 12).Select(n => n.LocationName).Where(n => !string.IsNullOrWhiteSpace(n))),
            Afternoon = string.Join("\n", g.Where(n => n.ArrivalTime.HasValue && n.ArrivalTime.Value.Hour >= 12 && n.ArrivalTime.Value.Hour < 18).Select(n => n.LocationName).Where(n => !string.IsNullOrWhiteSpace(n))),
            Evening = string.Join("\n", g.Where(n => n.ArrivalTime.HasValue && n.ArrivalTime.Value.Hour >= 18).Select(n => n.LocationName).Where(n => !string.IsNullOrWhiteSpace(n))),
            LegacyRoute = string.Join(" → ", g.Where(n => !n.ArrivalTime.HasValue).Select(n => n.Description).Where(n => !string.IsNullOrWhiteSpace(n))),
            Note = string.Join("\n", g.Select(n => n.Remarks).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct()),
        })
        .ToList();
    var visibleDays = Math.Max(4, Math.Max(post.TravelDays, days.Count));
    var cover = Model.Images.FirstOrDefault();
    var viewerMemberId = Context.Request.Query["viewerMemberId"].ToString();
    if (string.IsNullOrWhiteSpace(viewerMemberId) && post.Status == VlogPostStatus.Published) viewerMemberId = post.MemberId.ToString();
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>新增揪團文章 - Lazy Travel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700;800&family=Noto+Serif+TC:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/explore-edit.css" asp-append-version="true" />
</head>
<body class="home-app article-editor-page">
<div class="app">
    @await Html.PartialAsync("_HomeSidebar", "Explore")
    <main class="main editor-main">
        <form id="article-antiforgery">@Html.AntiForgeryToken()</form>
        <button class="editor-link-back" type="button" aria-label="返回上一頁" data-back-fallback="@Url.Action("Index", "Explore")">＜</button>
        <div class="editor-shell" data-post-id="@post.PostId" data-viewer-member-id="@viewerMemberId">
            <header class="editor-heading">
                <h1>@(post.Status == VlogPostStatus.Published ? "編輯揪團文章" : "新增揪團文章")</h1>
            </header>

            <section class="editor-top-grid">
                <div class="editor-card basic-card">
                    <h2>文章基本資訊</h2>
                    <label class="editor-field full">
                        <span>行程主題</span>
                        <input id="articleTitle" type="text" value="@(post.Title == "未命名文章" ? "" : post.Title)" placeholder="輸入文章標題" maxlength="100" />
                    </label>
                    <label class="editor-field full intro-field">
                        <span>旅程前言</span>
                        <textarea id="articleIntro" rows="3" placeholder="寫下這趟旅程的前言、亮點或想分享給旅伴的心情...">@Model.PlainContent</textarea>
                    </label>
                    <label class="editor-field full highlight-field">
                        <span>一句話亮點</span>
                        <input id="articleHighlight" type="text" value="@Model.Highlight" placeholder="例如：慢下來，才看見關西春天真正的溫柔。" maxlength="180" />
                    </label>
                    <div class="editor-info-layout">
                        <div class="trip-info">
                            <h3>行程資訊</h3>
                            <label><span>◎ 國家</span><input id="articleCountry" type="text" value="@country" placeholder="例如：日本" maxlength="100" /></label>
                            <label><span>⌖ 地區</span><input id="articleRegion" type="text" value="@region" placeholder="例如：關西、大阪" maxlength="100" /></label>
                            <label><span>▦ 旅遊日期</span><span class="date-range-picker"><input id="articleStartDate" type="hidden" value="@startDate" /><input id="articleEndDate" type="hidden" value="@endDate" /><input id="articleDateRange" type="text" value="@(string.IsNullOrWhiteSpace(startDate) ? "" : $"{startDate} 至 {endDate}")" placeholder="選擇起訖日期" autocomplete="off" readonly /></span></label>
                            <label><span>♙ 總人數</span><select id="articlePeople">
                                @foreach (TravelGroupSize size in Enum.GetValues<TravelGroupSize>())
                                {
                                    <option value="@size" selected="@(post.TravelPeople == size)">@size.ToLabel()</option>
                                }
                            </select></label>
                        </div>
                    </div>
                </div>

                <div class="editor-card upload-card">
                    <h2>圖片上傳</h2>
                    <div class="photo-upload-grid">
                        <div>
                            <h3>封面圖片</h3>
                            <input id="coverImageInput" class="upload-input" type="file" accept="image/*" />
                            <button class="cover-preview upload-picker" type="button" data-file-target="coverImageInput">
                                @if (!string.IsNullOrWhiteSpace(cover))
                                {
                                    <img src="@cover" alt="封面圖片" data-cover-preview />
                                    <span class="upload-hint">點擊更換封面</span>
                                }
                                else
                                {
                                    <span class="empty-upload" data-cover-empty>＋<small>選擇封面圖片</small></span>
                                }
                            </button>
                            <button class="remove-cover" type="button" aria-label="移除封面">×</button>
                        </div>
                        <div>
                            <h3>補充照片</h3>
                            <input id="supportImagesInput" class="upload-input" type="file" accept="image/*" multiple />
                            <button class="support-upload upload-picker" type="button" data-file-target="supportImagesInput">
                                <span>＋</span>
                                <strong>新增圖片</strong>
                                <small>選填</small>
                            </button>
                        </div>
                    </div>
                    <div class="support-preview-area">
                        <div class="support-large-preview" data-support-large>
                            @if (Model.Images.Skip(1).FirstOrDefault() is { } firstSupport)
                            {
                                <img src="@firstSupport" alt="補充照片預覽" />
                            }
                            else
                            {
                                <span>尚未選擇補充照片</span>
                            }
                        </div>
                        <div class="support-strip" aria-label="補充照片縮圖預覽" data-support-strip>
                            @foreach (var image in Model.Images.Skip(1))
                            {
                                <button type="button" class="support-thumb"><img src="@image" alt="補充照片" /></button>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <section class="itinerary-editor" aria-labelledby="itinerary-title">
                <div class="section-title-row">
                    <h2 id="itinerary-title">行程內容</h2>
                    <button class="add-day" type="button" aria-label="新增一天">＋</button>
                </div>
                <div id="dayList">
                    @for (var i = 1; i <= visibleDays; i++)
                    {
                        var day = days.FirstOrDefault(d => d.Day == i);
                        <article class="day-edit-card" data-day>
                            <strong>DAY @i</strong>
                            <div class="day-fields">
                                <input class="day-title" type="text" value="@day?.Title" placeholder="輸入每日標題（例如：大阪城公園、心齋橋逛街）" />
                                <textarea class="day-morning" rows="2" placeholder="早上行程，例如：清水寺參拜、二年坂散步">@(string.IsNullOrWhiteSpace(day?.Morning) ? day?.LegacyRoute : day?.Morning)</textarea>
                                <textarea class="day-afternoon" rows="2" placeholder="下午行程，例如：嵐山竹林、渡月橋">@day?.Afternoon</textarea>
                                <textarea class="day-evening" rows="2" placeholder="晚上行程，例如：祇園晚餐、鴨川散步">@day?.Evening</textarea>
                                <label class="note-row"><span>心得筆記</span><textarea class="day-note-input" rows="1" placeholder="寫下今天的旅行心得...">@day?.Note</textarea></label>
                            </div>
                            <button class="remove-day" type="button" aria-label="移除這一天">×</button>
                        </article>
                    }
                </div>
            </section>
        </div>
        <div class="editor-actions">
            <button class="submit-article" type="button" data-action="submit">✈ 送出</button>
        </div>
    </main>
</div>
<script src="~/js/sidebar.js" asp-append-version="true"></script>
<script src="~/lib/flatpickr/flatpickr.min.js" asp-append-version="true"></script>
<script src="~/js/explore-edit.js" asp-append-version="true"></script>
</body>
</html>



