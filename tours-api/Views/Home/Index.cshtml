@model LazyTravel.ViewModels.TravelGroupIndexViewModel
@{
    ViewData["Title"] = "首頁";
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lazy Travel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700;800&family=Noto+Serif+TC:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/travelgroups-index.css" asp-append-version="true" />
</head>
<body class="home-app home-page groups-page">
<div class="app">
    @await Html.PartialAsync("_HomeSidebar", "Home")
    <div class="sidebar-scrim" aria-hidden="true"></div>

    <main class="main">
        <div class="content-wrap">
            <section class="hero-wrap" aria-label="LazyTravel 特色輪播">
                <div class="hero-row home-hero-full">
                    <div class="hero" id="hero" aria-live="polite"></div>
                </div>
                <div class="hero-dots" id="hero-dots" aria-label="輪播切換"></div>
            </section>

            <form class="groups-filter home-groups-filter" method="get" asp-controller="TravelGroups" asp-action="Index">
                <input type="hidden" name="scope" value="all" />
                <input type="hidden" id="groupStartDate" name="startDate" value="" />
                <input type="hidden" id="groupEndDate" name="endDate" value="" />

                <div class="filter-control filter-country">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 4 5.8 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.8-4-9s1.5-6.5 4-9Z"/></svg>
                    <label for="groupCountry">國家</label>
                    <div class="country-combobox">
                        <input id="groupCountry" name="country" type="text" value="" placeholder="輸入或選擇國家" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="groupCountryOptions" aria-describedby="countryError" />
                        <button class="country-toggle" type="button" aria-label="展開國家選單" tabindex="-1"><svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg></button>
                    </div>
                    <div id="groupCountryOptions" class="country-options" role="listbox" aria-label="國家" hidden>
                        <div role="option" data-value="" aria-selected="false">所有國家</div>
                        @foreach (var item in Model.AllCountries)
                        {
                            <div role="option" data-value="@item" aria-selected="false">@item</div>
                        }
                        <div class="country-empty" role="status" hidden>沒有符合的國家</div>
                    </div>
                    <div id="countryError" class="country-error" role="status" hidden>請選擇清單中的國家，或清空欄位。</div>
                </div>

                <label class="filter-control filter-control-date" for="groupDateRange">
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
                    <span>行程區間</span>
                    <input id="groupDateRange" type="text" value="" placeholder="選擇起訖日期" autocomplete="off" readonly />
                </label>

                <button class="filter-submit" type="submit" aria-label="搜尋揪團">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
                </button>
            </form>

            <section class="row-section">
                <div class="row-head">
                    <h3>熱門行程</h3>
                    <a href="/TravelGroups" class="row-more">查看全部<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
                </div>
                <div class="row-scroller">
                    <button class="row-nav prev" type="button" data-row="trip-row" data-dir="-1" aria-label="上一批熱門行程"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M15 6l-6 6 6 6"/></svg></button>
                    <div class="row-track" id="trip-row"></div>
                    <button class="row-nav next" type="button" data-row="trip-row" data-dir="1" aria-label="下一批熱門行程"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></button>
                </div>
            </section>

            <section class="row-section">
                <div class="row-head">
                    <h3>熱門文章</h3>
                    <a href="/Explore" class="row-more">查看全部<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
                </div>
                <div class="row-scroller">
                    <button class="row-nav prev" type="button" data-row="article-row" data-dir="-1" aria-label="上一批熱門文章"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M15 6l-6 6 6 6"/></svg></button>
                    <div class="row-track" id="article-row"></div>
                    <button class="row-nav next" type="button" data-row="article-row" data-dir="1" aria-label="下一批熱門文章"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></button>
                </div>
            </section>
        </div>
    </main>
</div>
<script src="~/lib/flatpickr/flatpickr.min.js" asp-append-version="true"></script>
<script src="~/js/sidebar.js" asp-append-version="true"></script>
<script src="~/js/home.js" asp-append-version="true"></script>
<script src="~/js/travelgroups-index.js" asp-append-version="true"></script>
</body>
</html>
