@{
    ViewData["Title"] = "首頁";
    // 這頁是完全自訂的側欄版型(跟 _Layout.cshtml 的上方導覽列不同一套)，所以不套 _Layout，
    // 避免疊出兩組導覽。畫面上的行程/文章資料一律由 wwwroot/js/home.js 向 /Home/Data 拿真實資料，
    // 這裡本身不寫死任何一筆行程或文章。
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lazy Travel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=Baloo+2:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
</head>
<body class="home-app">
    <div class="app">
        @await Html.PartialAsync("_HomeSidebar", "Home")

        <main class="main">
            <div class="content-wrap">
                <div class="hero-row">
                    <div class="hero" id="hero"></div>
                        <div class="globe-panel">
                            <div class="globe-frame">
                                <div class="globe-label">
                                    <span class="globe-label-text">探索揪團地圖</span>
                                    <svg class="globe-label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M2 12.5L21 3l-6.5 19-3.5-8-8-1z"/>
                                        <path d="M14.5 14L21 3"/>
                                    </svg>
                                </div>
                                <canvas class="globe-canvas" id="globe-canvas"></canvas>
                                <div class="globe-drag-hint" id="globe-drag-hint">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 3a2 2 0 0 1 4 0v6"/>
                                        <path d="M13 5a2 2 0 0 1 4 0v5"/>
                                        <path d="M17 7.5a2 2 0 0 1 4 0V13c0 4.4-3.1 8-7.5 8h-1c-3 0-4.2-1-6-3l-3-4.2c-.6-.9-.3-2 .6-2.5.9-.5 2-.2 2.6.6L9 14"/>
                                        <path d="M9 9v4"/>
                                    </svg>
                                    <span>拖曳探索</span>
                                </div>
                            </div>
                            <div class="globe-pins" id="globe-pins"></div>
                            <div class="globe-tooltip" id="globe-tooltip" hidden></div>
                        </div>
                </div>
                <div class="hero-dots" id="hero-dots"></div>

                <div class="search-bar">
                    <div class="search-field">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-6.6 7-12a7 7 0 10-14 0c0 5.4 7 12 7 12z"/><circle cx="12" cy="9" r="2.4"/></svg>
                        <select><option>亞洲</option><option>歐洲</option><option>美洲</option></select>
                    </div>
                    <div class="search-sep"></div>
                    <div class="search-field">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 4 6 4 9s-1.5 6.5-4 9c-2.5-2.5-4-6-4-9s1.5-6.5 4-9z"/></svg>
                        <select><option>日本</option><option>冰島</option><option>義大利</option></select>
                    </div>
                    <div class="search-sep"></div>
                    <div class="search-field">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
                        <select><option>3 天以內</option><option>4-7 天</option><option>8 天以上</option></select>
                    </div>
                    <button class="search-btn" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>搜尋</button>
                </div>

                <section class="row-section">
                    <div class="row-head">
                        <h3>熱門行程</h3>
                        <a href="/TravelGroups" class="row-more">查看全部<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></a>
                    </div>
                    <div class="row-scroller">
                        <button class="row-nav prev" data-row="trip-row" data-dir="-1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M15 6l-6 6 6 6"/></svg></button>
                        <div class="row-track" id="trip-row"></div>
                        <button class="row-nav next" data-row="trip-row" data-dir="1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></button>
                    </div>
                </section>

                <section class="row-section">
                    <div class="row-head">
                        <h3>熱門文章</h3>
                        <a asp-controller="Explore" asp-action="Index" class="row-more">查看全部<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></a>
                    </div>
                    <div class="row-scroller">
                        <button class="row-nav prev" data-row="article-row" data-dir="-1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M15 6l-6 6 6 6"/></svg></button>
                        <div class="row-track" id="article-row"></div>
                        <button class="row-nav next" data-row="article-row" data-dir="1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></button>
                    </div>
                </section>
            </div>
        </main>
    </div>

    <script src="~/js/globe.js" asp-append-version="true"></script>
    <script src="~/js/home.js" asp-append-version="true"></script>
</body>
</html>
