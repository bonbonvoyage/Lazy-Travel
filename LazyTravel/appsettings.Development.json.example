// 這是範本檔，會進版控。
//
// 每台新電腦 clone 完，把這支複製一份改名成 appsettings.Development.json
// （真正的那支被 .gitignore 擋著，不會進版控），然後改下面的 Server=。
//
// ── 怎麼知道這台電腦的執行個體名稱？在 PowerShell 執行：
//    Get-Service | Where-Object { $_.Name -like 'MSSQL$*' -or $_.Name -eq 'MSSQLSERVER' }
//
//    看到 MSSQLSERVER      → Server=.
//    看到 MSSQL$SQLEXPRESS → Server=.\SQLEXPRESS
//    看到 MSSQL$CECE       → Server=.\CECE
//    什麼都沒有，但裝了 LocalDB（執行 sqllocaldb info 看得到）
//                          → Server=(localdb)\MSSQLLocalDB
//
// ── 驗證兩種寫法，挑一種：
//    A. Windows 驗證（自己的電腦最方便，不用建帳號）
//    B. SQL 帳密（跟組員共用同一組，方便互相在 SSMS 排查）
{
  "ConnectionStrings": {
    // A. Windows 驗證
    "DefaultConnection": "Server=.\\你的執行個體名稱;Database=LazyTravelDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"

    // B. SQL 帳密（要用的話把上面那行註解掉，改用這行）
    // "DefaultConnection": "Server=.\\你的執行個體名稱;Database=LazyTravelDB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true"
  }
}
