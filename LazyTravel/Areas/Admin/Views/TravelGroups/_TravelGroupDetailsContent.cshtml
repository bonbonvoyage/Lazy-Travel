@model LazyTravel.Models.EfModels.TravelGroup

@{
    var recentOperationRemarks = (Model.TravelGroupsLogs ?? Enumerable.Empty<LazyTravel.Models.EfModels.TravelGroupsLog>())
        .Where(log => !string.IsNullOrWhiteSpace(log.Remark))
        .OrderByDescending(log => log.CreatedAt)
        .Take(3)
        .ToList();
}

<table class="table table-bordered">
    <tr>
        <th>編號</th>
        <td>@Model.GroupId</td>
    </tr>

    <tr>
        <th>房間名稱</th>
        <td>@Model.GroupTitle</td>
    </tr>

    <tr>
        <th>國家</th>
        <td>@Model.Country</td>
    </tr>

    <tr>
        <th>地區</th>
        <td>@Model.Region</td>
    </tr>

    <tr>
        <th>團主</th>
        <td>
            @if (Model.OwnerMember != null)
            {
                <span>@Model.OwnerMember.Name</span><span>(Id=</span><a class="member-link" asp-area="Admin" asp-controller="Members" asp-action="Details" asp-route-id="@Model.OwnerMember.MemberId">@Model.OwnerMember.MemberId</a><span>)</span>
            }
            else
            {
                <span>—</span>
            }
        </td>
    </tr>

    <tr>
        <th>團內成員</th>
        <td>
            @if (Model.GroupMembers != null && Model.GroupMembers.Any())
            {
                var activeMembers = Model.GroupMembers
                    .Where(m => m.IsRemoved == false && m.LeftAt == null)
                    .ToList();

                if (activeMembers.Any())
                {
                    for (int i = 0; i < activeMembers.Count; i++)
                    {
                        var member = activeMembers[i];

                        if (i > 0)
                        {
                            <span>、</span>
                        }

                        if (member.Member != null)
                        {
                            <span>@member.Member.Name</span><span>(Id=</span><a class="member-link" asp-area="Admin" asp-controller="Members" asp-action="Details" asp-route-id="@member.Member.MemberId">@member.Member.MemberId</a><span>)</span>
                        }
                        else
                        {
                            <span>—</span>
                        }

                        <span>(@member.MemberRole)</span>
                    }
                }
                else
                {
                    <span>目前無成員資料</span>
                }
            }
            else
            {
                <span>目前無成員資料</span>
            }
        </td>
    </tr>

    <tr>
        <th>目前人數</th>
        <td>@Model.CurrentPeople</td>
    </tr>

    <tr>
        <th>最少成行人數</th>
        <td>@Model.MinPeople</td>
    </tr>

    <tr>
        <th>人數上限</th>
        <td>@Model.MaxPeople</td>
    </tr>

    <tr>
        <th>加入規則</th>
        <td>@Model.JoinRule</td>
    </tr>

    <tr>
        <th>揪團狀態</th>
        <td>@Model.GroupStatus</td>
    </tr>

    <tr>
        <th>審核狀態</th>
        <td>@Model.ReviewStatus</td>
    </tr>

    <tr>
        <th>是否公開</th>
        <td>@(Model.IsPublic ? "公開" : "不公開")</td>
    </tr>

    <tr>
        <th>行程時間</th>
        <td>
            @if (Model.StartDate != null && Model.EndDate != null)
            {
                @($"{Model.StartDate:yyyy-MM-dd} ～ {Model.EndDate:yyyy-MM-dd}")
            }
            else
            {
                <span>尚未設定</span>
            }
        </td>
    </tr>

    <tr>
        <th>建立時間</th>
        <td>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
    </tr>

    <tr>
        <th>更新時間</th>
        <td>@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
    </tr>

    <tr>
        <th>操作異動說明</th>
        <td>
            <form asp-area="Admin"
                  asp-controller="TravelGroups"
                  asp-action="SaveOperationRemark"
                  asp-route-id="@Model.GroupId"
                  method="post"
                  class="operation-remark-form">
                @Html.AntiForgeryToken()
                <textarea name="operationRemark"
                          class="form-control"
                          maxlength="200"
                          rows="3"
                          placeholder="請填寫本次操作或補充說明，最多 200 字"
                          required></textarea>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <small class="text-muted">最多 200 字</small>
                    <button type="submit" class="btn btn-sm btn-save-pantone">儲存</button>
                </div>
            </form>

            <div class="operation-remark-history mt-3">
                <div class="small text-muted mb-2">最近操作異動說明</div>
                @if (recentOperationRemarks.Any())
                {
                    <div class="list-group list-group-flush border rounded">
                        @foreach (var log in recentOperationRemarks)
                        {
                            <div class="list-group-item px-2 py-2">
                                <div class="d-flex justify-content-between gap-2">
                                    <span class="fw-semibold">@log.ChangeType</span>
                                    <span class="text-muted small">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                </div>
                                <div class="small mt-1">@log.Remark</div>
                                <div class="text-muted small mt-1">
                                    @(log.ChangedByEmployee != null ? $"{log.ChangedByEmployee.Name}(Id={log.ChangedByEmployee.EmployeeId})" : "系統管理員")
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted small border rounded px-2 py-2">目前沒有操作異動說明紀錄</div>
                }
            </div>
        </td>
    </tr>
</table>
