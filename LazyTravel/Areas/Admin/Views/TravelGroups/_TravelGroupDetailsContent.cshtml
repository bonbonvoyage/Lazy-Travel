@model LazyTravel.Models.TravelGroup

<table class="table table-bordered">
    <tr>
        <th>編號</th>
        <td>@Model.GroupId</td>
    </tr>

    <tr>
        <th>房間名稱</th>
        <td>@Model.GroupTitle</td>
    </tr>

    <tr>
        <th>國家</th>
        <td>@Model.Country</td>
    </tr>

    <tr>
        <th>地區</th>
        <td>@Model.Region</td>
    </tr>

    <tr>
        <th>團主</th>
        <td>
            @if (Model.OwnerMember != null)
            {
                <span>@Model.OwnerMember.Name</span><span>(Id=</span><a class="member-link" asp-area="Admin" asp-controller="Members" asp-action="Details" asp-route-id="@Model.OwnerMember.MemberId">@Model.OwnerMember.MemberId</a><span>)</span>
            }
            else
            {
                <span>—</span>
            }
        </td>
    </tr>

    <tr>
        <th>團內成員</th>
        <td>
            @if (Model.GroupMembers != null && Model.GroupMembers.Any())
            {
                var activeMembers = Model.GroupMembers
                    .Where(m => m.IsRemoved == false && m.LeftAt == null)
                    .ToList();

                if (activeMembers.Any())
                {
                    for (int i = 0; i < activeMembers.Count; i++)
                    {
                        var member = activeMembers[i];

                        if (i > 0)
                        {
                            <span>、</span>
                        }

                        if (member.Member != null)
                        {
                            <span>@member.Member.Name</span><span>(Id=</span><a class="member-link" asp-area="Admin" asp-controller="Members" asp-action="Details" asp-route-id="@member.Member.MemberId">@member.Member.MemberId</a><span>)</span>
                        }
                        else
                        {
                            <span>—</span>
                        }

                        <span>(@member.MemberRole)</span>
                    }
                }
                else
                {
                    <span>目前無成員資料</span>
                }
            }
            else
            {
                <span>目前無成員資料</span>
            }
        </td>
    </tr>

    <tr>
        <th>目前人數</th>
        <td>@Model.CurrentPeople</td>
    </tr>

    <tr>
        <th>最少成行人數</th>
        <td>@Model.MinPeople</td>
    </tr>

    <tr>
        <th>人數上限</th>
        <td>@Model.MaxPeople</td>
    </tr>

    <tr>
        <th>加入規則</th>
        <td>@Model.JoinRule</td>
    </tr>

    <tr>
        <th>揪團狀態</th>
        <td>@Model.GroupStatus</td>
    </tr>

    <tr>
        <th>審核狀態</th>
        <td>@Model.ReviewStatus</td>
    </tr>

    <tr>
        <th>是否公開</th>
        <td>@(Model.IsPublic ? "公開" : "不公開")</td>
    </tr>

    <tr>
        <th>行程時間</th>
        <td>
            @if (Model.StartDate != null && Model.EndDate != null)
            {
                @($"{Model.StartDate:yyyy-MM-dd} ～ {Model.EndDate:yyyy-MM-dd}")
            }
            else
            {
                <span>尚未設定</span>
            }
        </td>
    </tr>

    <tr>
        <th>建立時間</th>
        <td>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
    </tr>

    <tr>
        <th>更新時間</th>
        <td>@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
    </tr>
</table>
