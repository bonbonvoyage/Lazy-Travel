@model LazyTravel.Models.ViewModels.TravelGroupAdminIndexViewModel

@{
    ViewData["Title"] = "揪團管理";

    string FormatGrowthRate(double? rate)
    {
        if (rate == null)
        {
            return "N/A";
        }

        var sign = rate.Value > 0 ? "+" : "";
        return $"{sign}{rate.Value}%";
    }
}

<h1>揪團管理</h1>

<div id="groupAlertRegion">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
</div>

<!-- 儀表板統計列 -->
<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">全部揪團</div>
            <div class="stat-value">@Model.TotalGroupsCount</div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">異常揪團</div>
            <div class="stat-value">@Model.AbnormalGroupsCount</div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">與上個月新增揪團數增加率</div>
            <div class="stat-value">@FormatGrowthRate(Model.NewGroupsGrowthRatePercent)</div>
        </div>
    </div>
</div>

<!-- 篩選列（滿版單排） -->
<form asp-area="Admin"
      asp-controller="TravelGroups"
      asp-action="Index"
      method="get"
      id="groupFilterForm"
      class="filter-row">

    <input type="hidden" name="tab" id="filterTabInput" value="@Model.Tab" />

    <div class="flex-fill" style="min-width: 220px;">
        <label class="form-label mb-1">關鍵字搜尋</label>
        <input type="text"
               name="keyword"
               value="@Model.Keyword"
               class="form-control admin-field"
               placeholder="搜尋編號、房間名稱、說明、國家、地區、團主" />
    </div>

    <div class="flex-fill" style="min-width: 200px;">
        <label class="form-label mb-1">審核狀態</label>
        <select name="selectedReviewStatus" class="form-select admin-field">
            <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedReviewStatus))">全部狀態</option>
            <option value="正常" selected="@(Model.SelectedReviewStatus == "正常")">正常</option>
            <option value="檢舉審核中" selected="@(Model.SelectedReviewStatus == "檢舉審核中")">審核檢舉中</option>
            <option value="違規" selected="@(Model.SelectedReviewStatus == "違規")">違規</option>
            <option value="已下架" selected="@(Model.SelectedReviewStatus == "已下架")">已下架</option>
        </select>
    </div>

    <div class="flex-fill" style="min-width: 160px;">
        <label class="form-label mb-1">排序</label>
        <select name="sortOrder" class="form-select admin-field">
            <option value="asc" selected="@(Model.SortOrder == "asc")">編號小到大 ↑</option>
            <option value="desc" selected="@(Model.SortOrder == "desc")">編號大到小 ↓</option>
        </select>
    </div>

    <div class="flex-fill" style="min-width: 160px;">
        <label class="form-label mb-1">建立時間(起)</label>
        <input type="date"
               name="createdAtFrom"
               value="@Model.CreatedAtFrom?.ToString("yyyy-MM-dd")"
               class="form-control admin-field" />
    </div>

    <div class="flex-fill" style="min-width: 160px;">
        <label class="form-label mb-1">建立時間(迄)</label>
        <input type="date"
               name="createdAtTo"
               value="@Model.CreatedAtTo?.ToString("yyyy-MM-dd")"
               class="form-control admin-field" />
    </div>

    <div class="d-flex gap-2" style="align-self: flex-end;">
        <button type="submit" class="btn btn-primary admin-field">搜尋</button>

        <div class="d-flex gap-2" style="align-self: flex-end;">
        <a asp-area="Admin"
           asp-controller="TravelGroups"
           asp-action="Index"
           class="btn admin-field btn-clear-pantone">
            清除
        </a>
    </div>
</form>

<div id="groupsRegion">
    <partial name="_TravelGroupsTabContent" model="Model" />
</div>

<style>
    /* 依「編號」欄位單數跳色，方便管理員閱讀（揪團清單、已刪除清單、異動紀錄三個清單一致） */
    .zebra-row {
        background-color: #D8EBF2;
    }

    /* 篩選區塊內的欄位統一高度與樣式，視覺一致 */
    .admin-field {
        height: 42px;
    }

    select.admin-field {
        height: 42px;
    }

    /* 篩選列滿版：欄位平均撐開，右側不留白 */
    .filter-row {
        align-items: flex-start;
    }

    /* 清除鈕：外觀比照搜尋鈕，色號 PANTONE 184C */
    .btn-clear-pantone {
        background-color: #F65275;
        border-color: #F65275;
        color: #fff;
    }
    .btn-clear-pantone:hover,
    .btn-clear-pantone:focus {
        background-color: #e13d61;
        border-color: #e13d61;
        color: #fff;
    }

    /* 詳細鈕：色號 PANTONE 16-4032，文字白色 */
    .btn-detail-pantone {
        background-color: #658DC6;
        border-color: #658DC6;
        color: #fff;
    }
    .btn-detail-pantone:hover,
    .btn-detail-pantone:focus {
        background-color: #517aB4;
        border-color: #517aB4;
        color: #fff;
    }

    /* 頁籤與下方清單視窗連在一起，中間不留空白 */
    .admin-tabs {
        margin-bottom: 0;
        border-bottom: 1px solid var(--border-soft, #dee2e6);
    }

    .admin-tab-panel {
        background-color: var(--surface, #fff);
        border: 1px solid var(--border-soft, #dee2e6);
        border-top: none;
        border-radius: 0 0 var(--radius-md, .5rem) var(--radius-md, .5rem);
        padding: 1rem;
    }

    .admin-tabs .nav-link {
        border-radius: var(--radius-md, .5rem) var(--radius-md, .5rem) 0 0;
    }

    .admin-tabs .nav-link.active {
        border-bottom-color: var(--surface, #fff);
    }
</style>

<script>
    function goToPage(inputId, tabName, totalPages) {
        var input = document.getElementById(inputId);
        var page = parseInt(input.value, 10);

        if (!page || page < 1) {
            page = 1;
        }

        if (totalPages && page > totalPages) {
            page = totalPages;
        }

        var params = new URLSearchParams(window.location.search);
        params.set('tab', tabName);

        if (tabName === 'active') {
            params.set('activePage', page);
        } else if (tabName === 'deleted') {
            params.set('deletedPage', page);
        } else if (tabName === 'log') {
            params.set('logPage', page);
        }

        loadGroupsRegion('@Url.Action("Index", "TravelGroups", new { area = "Admin" })' + '?' + params.toString());
    }

    function loadGroupsRegion(url) {
        var region = document.getElementById('groupsRegion');
        region.style.opacity = '0.5';

        fetch(url, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error('載入失敗');
                }
                return response.text();
            })
            .then(function (html) {
                region.innerHTML = html;
                region.style.opacity = '1';

                // 同步網址列，避免重新整理後跳回第一頁／預設頁籤
                try {
                    window.history.replaceState(null, '', url);
                } catch (e) {
                    // 部分環境（例如檔案協定）不支援 history API，忽略即可
                }

                // 同步篩選表單中的目前頁籤，讓「搜尋」按鈕送出時能保留頁籤
                var urlParams = new URLSearchParams(url.split('?')[1] || '');
                var tabInput = document.getElementById('filterTabInput');
                if (tabInput && urlParams.get('tab')) {
                    tabInput.value = urlParams.get('tab');
                }
            })
            .catch(function () {
                region.style.opacity = '1';
                window.location.href = url;
            });
    }

    // 事件代理：攔截頁籤與分頁連結的點擊，改用 AJAX 載入，不重新整理頁面
    document.addEventListener('click', function (e) {
        var link = e.target.closest('.ajax-nav-link');
        if (!link) {
            return;
        }

        e.preventDefault();
        loadGroupsRegion(link.getAttribute('href'));
    });
</script>
