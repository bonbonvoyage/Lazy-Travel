@model LazyTravel.Models.ViewModels.TravelGroupAdminIndexViewModel

@{
    ViewData["Title"] = "揪團管理";
    var deletedGroups = ViewBag.DeletedGroups as List<LazyTravel.Models.TravelGroup>;
}

<h1>揪團管理</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<h3>揪團清單</h3>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>操作</th>
            <th>編號</th>
            <th>房間名稱</th>
            <th>國家</th>
            <th>地區</th>
            <th>團主</th>
            <th>目前人數</th>
            <th>人數上限</th>
            <th>加入規則</th>
            <th>揪團狀態</th>
            <th>審核狀態</th>
            <th>公開</th>
            <th>建立時間</th>
            <th>房間內容</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr ondblclick="location.href='@Url.Action("Details", "TravelGroups", new { area = "Admin", id = item.GroupId })'"
                style="cursor:pointer;">
                <td>
                    @if (item.ReviewStatus == "檢舉審核中" ||
                                    item.ReviewStatus == "已下架" ||
                                    item.ReviewStatus == "違規")
                    {
                        <form asp-area="Admin"
                              asp-controller="TravelGroups"
                              asp-action="Delete"
                              asp-route-id="@item.GroupId"
                              method="post"
                              onsubmit="return confirm('確定要將這筆揪團移至已刪除清單嗎？');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">刪除</button>
                        </form>
                    }
                </td>
                <td>@item.GroupId</td>
                <td>@item.GroupTitle</td>
                <td>@item.Country</td>
                <td>@item.Region</td>
                <td>@item.OwnerMember?.Name</td>
                <td>@item.CurrentPeople</td>
                <td>@item.MaxPeople</td>
                <td>@item.JoinRule</td>
                <td>@item.GroupStatus</td>
                <td>@item.ReviewStatus</td>
                <td>@(item.IsPublic ? "公開" : "不公開")</td>
                <td>@item.CreatedAt</td>
                <td>
                    <a asp-area="Admin"
                       asp-controller="TravelGroups"
                       asp-action="Details"
                       asp-route-id="@item.GroupId"
                       class="btn btn-sm btn-info">
                        詳細
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

<h3>已刪除清單</h3>

<table class="table table-bordered table-hover table-secondary">
    <thead>
        <tr>
            <th>操作</th>
            <th>編號</th>
            <th>房間名稱</th>
            <th>國家</th>
            <th>地區</th>
            <th>團主</th>
            <th>目前人數</th>
            <th>人數上限</th>
            <th>加入規則</th>
            <th>揪團狀態</th>
            <th>審核狀態</th>
            <th>公開</th>
            <th>建立時間</th>
            <th>房間內容</th>
        </tr>
    </thead>
    <tbody>
        @if (deletedGroups != null && deletedGroups.Any())
        {
            foreach (var item in deletedGroups)
            {
                <tr ondblclick="location.href='@Url.Action("Details", "TravelGroups", new { area = "Admin", id = item.GroupId })'"
                    style="cursor:pointer;">
                    <td>
                        <form asp-area="Admin"
                              asp-controller="TravelGroups"
                              asp-action="Restore"
                              asp-route-id="@item.GroupId"
                              method="post"
                              onsubmit="return confirm('確定要還原這筆揪團嗎？');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-success">還原</button>
                        </form>
                    </td>
                    <td>@item.GroupId</td>
                    <td>@item.GroupTitle</td>
                    <td>@item.Country</td>
                    <td>@item.Region</td>
                    <td>@item.OwnerMember?.Name</td>
                    <td>@item.CurrentPeople</td>
                    <td>@item.MaxPeople</td>
                    <td>@item.JoinRule</td>
                    <td>@item.GroupStatus</td>
                    <td>@item.ReviewStatus</td>
                    <td>@(item.IsPublic ? "公開" : "不公開")</td>
                    <td>@item.CreatedAt</td>
                    <td>
                        <a asp-area="Admin"
                           asp-controller="TravelGroups"
                           asp-action="Details"
                           asp-route-id="@item.GroupId"
                           class="btn btn-sm btn-info">
                            詳細
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="14" class="text-center">目前沒有已刪除資料</td>
            </tr>
        }
    </tbody>
