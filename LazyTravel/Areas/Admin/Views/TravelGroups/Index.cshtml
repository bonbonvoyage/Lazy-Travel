@model LazyTravel.Models.ViewModels.TravelGroupAdminIndexViewModel

@{
    ViewData["Title"] = "揪團管理";
}


<div id="groupAlertRegion">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
</div>

<!-- 篩選列（滿版單排） -->
<form asp-area="Admin"
      asp-controller="TravelGroups"
      asp-action="Index"
      method="get"
      id="groupFilterForm"
      class="filter-row">

    <input type="hidden" name="tab" id="filterTabInput" value="@Model.Tab" />

    <div class="flex-fill" style="min-width: 220px;">
        <label class="form-label mb-1">關鍵字搜尋</label>
        <input type="text"
               name="keyword"
               value="@Model.Keyword"
               class="form-control admin-field"
               placeholder="搜尋編號、房間名稱、說明、國家、地區、團主" />
    </div>

    <div class="flex-fill" style="min-width: 200px;">
        <label class="form-label mb-1">審核狀態</label>
        <select name="selectedReviewStatus" class="form-select admin-field">
            <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedReviewStatus))">全部狀態</option>
            <option value="正常" selected="@(Model.SelectedReviewStatus == "正常")">正常</option>
            <option value="檢舉審核中" selected="@(Model.SelectedReviewStatus == "檢舉審核中")">審核檢舉中</option>
            <option value="違規" selected="@(Model.SelectedReviewStatus == "違規")">違規</option>
        </select>
    </div>

    <div class="flex-fill" style="min-width: 160px;">
        <label class="form-label mb-1">排序</label>
        <select name="sortOrder" class="form-select admin-field">
            <option value="asc" selected="@(Model.SortOrder == "asc")">編號小到大 ↑</option>
            <option value="desc" selected="@(Model.SortOrder == "desc")">編號大到小 ↓</option>
        </select>
    </div>

    <div class="flex-fill" style="min-width: 260px;">
        <label class="form-label mb-1">建立時間</label>

        <input type="text"
               id="createdAtRange"
               class="form-control admin-field"
               placeholder="選擇建立時間區間"
               autocomplete="off"
               value="@(Model.CreatedAtFrom.HasValue && Model.CreatedAtTo.HasValue
                                                                           ? $"{Model.CreatedAtFrom:yyyy-MM-dd} 至 {Model.CreatedAtTo:yyyy-MM-dd}"
                                                                           : Model.CreatedAtFrom.HasValue
                                                                               ? $"{Model.CreatedAtFrom:yyyy-MM-dd}"
                                                                               : Model.CreatedAtTo.HasValue
                                                                                   ? $"{Model.CreatedAtTo:yyyy-MM-dd}"
                                                                                   : "")" />

        <input type="hidden"
               name="createdAtFrom"
               id="createdAtFrom"
               value="@Model.CreatedAtFrom?.ToString("yyyy-MM-dd")" />

        <input type="hidden"
               name="createdAtTo"
               id="createdAtTo"
               value="@Model.CreatedAtTo?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="d-flex gap-2" style="align-self: flex-end;">
        <a asp-area="Admin"
           asp-controller="TravelGroups"
           asp-action="Index"
           class="btn admin-field btn-clear-pantone">
            重設
        </a>
    </div>
</form>

<div class="groups-workspace">
    <div id="groupsRegion" class="groups-list-region">
        <partial name="_TravelGroupsTabContent" model="Model" />
    </div>

    <div id="groupDetailsBackdrop" class="group-details-backdrop" hidden></div>

    <aside id="groupDetailsPanel" class="group-details-panel" aria-live="polite" aria-hidden="true">
        <div class="details-panel-header">
            <h2 class="details-panel-title">揪團詳細內容</h2>
            <button type="button" class="btn-close" id="closeGroupDetailsPanel" aria-label="關閉詳細內容"></button>
        </div>
        <div id="groupDetailsContent" class="details-panel-content"></div>
    </aside>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<style>
    /* 篩選區塊內的欄位統一高度與樣式，視覺一致 */
    .admin-field {
        height: 42px;
    }

    select.admin-field {
        height: 42px;
    }

    /* 篩選列滿版：欄位平均撐開，右側不留白 */
    .filter-row {
        align-items: flex-start;
    }

    /* 重設鈕：使用品牌規格的海洋藍 */
    .btn-clear-pantone {
        background-color: var(--sea-600);
        border-color: var(--sea-600);
        color: #fff;
    }

        .btn-clear-pantone:hover,
        .btn-clear-pantone:focus {
            background-color: var(--sea-700);
            border-color: var(--sea-700);
            color: #fff;
        }

    .member-link {
        color: var(--sea-600);
        text-decoration: none;
        font-weight: 500;
    }

        .member-link:hover,
        .member-link:focus {
            color: var(--sea-700);
            text-decoration: underline;
        }

    .groups-workspace {
        position: relative;
        transition: padding-right .25s ease;
    }

        .groups-workspace.details-open {
            padding-right: min(520px, 42vw);
        }

    .groups-list-region {
        overflow-x: auto;
    }

        .groups-list-region .table.admin-table-card > tbody > tr:nth-of-type(even) > * {
            --bs-table-bg: #F7F1E6;
            --bs-table-accent-bg: #F7F1E6;
            background-color: #F7F1E6;
        }

        .groups-list-region .table.admin-table-card.table-hover > tbody > tr:hover > * {
            --bs-table-bg: var(--sea-50);
            --bs-table-accent-bg: var(--sea-50);
            background-color: var(--sea-50);
        }

    #activeGroups .admin-table-card,
    #abnormalGroups .admin-table-card,
    #deletedGroups .admin-table-card {
        table-layout: fixed;
        width: 100%;
    }

        #activeGroups .admin-table-card th,
        #activeGroups .admin-table-card td,
        #abnormalGroups .admin-table-card th,
        #abnormalGroups .admin-table-card td,
        #deletedGroups .admin-table-card th,
        #deletedGroups .admin-table-card td {
            overflow-wrap: anywhere;
            vertical-align: middle;
        }

    .groups-list-region .admin-table-card td:first-child {
        width: 56px;
        text-align: center;
        white-space: nowrap;
    }

        .groups-list-region .admin-table-card td:first-child form {
            margin: 0;
            width: 100%;
        }

        .groups-list-region .admin-table-card td:first-child .btn-sm {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 44px;
            max-width: 100%;
            padding: .16rem .45rem;
            font-size: .78rem;
            line-height: 1.25;
        }

    .groups-workspace.details-open .admin-table-card td:first-child {
        padding-left: .25rem;
        padding-right: .25rem;
    }

        .groups-workspace.details-open .admin-table-card td:first-child .btn-sm {
            width: 100%;
            min-width: 0;
            padding-left: .2rem;
            padding-right: .2rem;
            font-size: .72rem;
        }

    .group-details-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1040;
        background-color: transparent;
        pointer-events: none;
    }

        .group-details-backdrop.is-open {
            pointer-events: none;
        }

    .group-details-panel {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        z-index: 1050;
        width: min(520px, 42vw);
        overflow: auto;
        background-color: var(--surface, #fff);
        border-left: 1px solid var(--border-soft, #dee2e6);
        box-shadow: -12px 0 28px rgba(31, 61, 78, .16);
        padding: 1rem;
        transform: translateX(100%);
        transition: transform .25s ease;
    }

        .group-details-panel.is-open {
            transform: translateX(0);
        }

    .details-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: .75rem;
    }

    .details-panel-title {
        font-size: 1.05rem;
        margin-bottom: 0;
        color: var(--sea-800);
    }

    .group-details-panel .table {
        margin-bottom: 0;
    }

    .group-details-panel th {
        width: 110px;
        white-space: nowrap;
        color: var(--text-secondary);
    }

    /* 詳細鈕：色號 PANTONE 16-4032，文字白色 */
    .btn-detail-pantone {
        background-color: #658DC6;
        border-color: #658DC6;
        color: #fff;
    }

        .btn-detail-pantone:hover,
        .btn-detail-pantone:focus {
            background-color: #517aB4;
            border-color: #517aB4;
            color: #fff;
        }

    /* 頁籤與下方清單視窗連在一起，中間不留空白 */
    .admin-tabs {
        margin-bottom: 0;
        border-bottom: 1px solid var(--border-soft, #dee2e6);
    }

    .admin-tab-panel {
        background-color: var(--surface, #fff);
        border: 1px solid var(--border-soft, #dee2e6);
        border-top: none;
        border-radius: 0 0 var(--radius-md, .5rem) var(--radius-md, .5rem);
        padding: 1rem;
    }

    .admin-tabs .nav-link {
        border-radius: var(--radius-md, .5rem) var(--radius-md, .5rem) 0 0;
    }

        .admin-tabs .nav-link.active {
            border-bottom-color: var(--surface, #fff);
        }

    .tab-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.5rem;
        margin-left: .35rem;
        padding: .05rem .45rem;
        border-radius: var(--radius-pill, 999px);
        background-color: var(--sea-100);
        color: var(--sea-800);
        font-size: .78rem;
        font-variant-numeric: tabular-nums;
    }

    @@media (prefers-reduced-motion: reduce) {
        .groups-workspace,
        .group-details-panel {
            transition: none;
        }
    }

    @@media (max-width: 1199.98px) {
        .groups-workspace.details-open {
            padding-right: 0;
        }

        .group-details-panel {
            width: min(520px, 92vw);
        }

        .group-details-backdrop {
            background-color: rgba(31, 61, 78, .18);
        }

            .group-details-backdrop.is-open {
                opacity: 1;
                pointer-events: auto;
            }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/zh-tw.js"></script>

<script>
    function goToPage(inputId, tabName, totalPages) {
        var input = document.getElementById(inputId);
        var page = parseInt(input.value, 10);

        if (!page || page < 1) {
            page = 1;
        }

        if (totalPages && page > totalPages) {
            page = totalPages;
        }

        var params = new URLSearchParams(window.location.search);
        params.set('tab', tabName);

        if (tabName === 'active') {
            params.set('activePage', page);
        } else if (tabName === 'abnormal') {
            params.set('abnormalPage', page);
        } else if (tabName === 'deleted') {
            params.set('deletedPage', page);
        } else if (tabName === 'log') {
            params.set('logPage', page);
        }

        loadGroupsRegion('@Url.Action("Index", "TravelGroups", new { area = "Admin" })' + '?' + params.toString());
    }

    function loadGroupsRegion(url) {
        var region = document.getElementById('groupsRegion');
        region.style.opacity = '0.5';

        fetch(url, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error('載入失敗');
                }
                return response.text();
            })
            .then(function (html) {
                region.innerHTML = html;
                region.style.opacity = '1';

                try {
                    window.history.replaceState(null, '', url);
                } catch (e) {
                }

                var urlParams = new URLSearchParams(url.split('?')[1] || '');
                var tabInput = document.getElementById('filterTabInput');
                if (tabInput && urlParams.get('tab')) {
                    tabInput.value = urlParams.get('tab');
                }
            })
            .catch(function () {
                region.style.opacity = '1';
                window.location.href = url;
            });
    }

    function openGroupDetailsPanel() {
        var panel = document.getElementById('groupDetailsPanel');
        var backdrop = document.getElementById('groupDetailsBackdrop');
        var workspace = document.querySelector('.groups-workspace');

        if (!panel) {
            return;
        }

        panel.classList.add('is-open');
        panel.setAttribute('aria-hidden', 'false');

        if (workspace) {
            workspace.classList.add('details-open');
        }

        if (backdrop) {
            backdrop.hidden = false;
            window.requestAnimationFrame(function () {
                backdrop.classList.add('is-open');
            });
        }
    }

    function closeGroupDetailsPanel() {
        var panel = document.getElementById('groupDetailsPanel');
        var backdrop = document.getElementById('groupDetailsBackdrop');
        var workspace = document.querySelector('.groups-workspace');

        if (panel) {
            panel.classList.remove('is-open');
            panel.setAttribute('aria-hidden', 'true');
        }

        if (workspace) {
            workspace.classList.remove('details-open');
        }

        if (backdrop) {
            backdrop.classList.remove('is-open');
            window.setTimeout(function () {
                backdrop.hidden = true;
            }, 200);
        }
    }

    function loadGroupDetails(url, fallbackUrl) {
        var panel = document.getElementById('groupDetailsPanel');
        var content = document.getElementById('groupDetailsContent');
        if (!panel || !content) {
            window.location.href = fallbackUrl || url;
            return;
        }

        openGroupDetailsPanel();
        content.style.opacity = '0.5';

        fetch(url, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error('載入失敗');
                }
                return response.text();
            })
            .then(function (html) {
                content.innerHTML = html;
                content.style.opacity = '1';
            })
            .catch(function () {
                content.style.opacity = '1';
                window.location.href = fallbackUrl || url;
            });
    }

    document.addEventListener('click', function (e) {
        var detailLink = e.target.closest('.ajax-detail-link');
        if (detailLink) {
            e.preventDefault();
            loadGroupDetails(detailLink.dataset.detailUrl || detailLink.getAttribute('href'), detailLink.getAttribute('href'));
            return;
        }

        var link = e.target.closest('.ajax-nav-link');
        if (!link) {
            return;
        }

        e.preventDefault();
        loadGroupsRegion(link.getAttribute('href'));
    });

    document.addEventListener('click', function (e) {
        if (e.target.closest('.ajax-detail-link')) {
            return;
        }

        if (e.target.closest('#closeGroupDetailsPanel') || e.target.closest('#groupDetailsBackdrop')) {
            closeGroupDetailsPanel();
            return;
        }

        var panel = document.getElementById('groupDetailsPanel');
        if (panel && panel.classList.contains('is-open') &&
            !e.target.closest('#groupDetailsPanel') &&
            !e.target.closest('.ajax-detail-link')) {
            closeGroupDetailsPanel();
        }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            closeGroupDetailsPanel();
            return;
        }

        if (e.key !== 'Enter') {
            return;
        }

        var pageInput = e.target.closest('.page-jump-input');
        if (!pageInput) {
            return;
        }

        e.preventDefault();
        goToPage(pageInput.id, pageInput.dataset.tabName, parseInt(pageInput.dataset.totalPages, 10));
    });

    document.addEventListener('dblclick', function (e) {
        if (e.target.closest('a, button, input, select, textarea, form')) {
            return;
        }

        var row = e.target.closest('.group-detail-row');
        if (!row || !row.dataset.detailUrl) {
            return;
        }

        loadGroupDetails(row.dataset.detailUrl);
    });

    document.addEventListener('submit', function (e) {
        var restoreForm = e.target.closest('.restore-form');
        if (restoreForm) {
            var input = restoreForm.querySelector('input[name="operationRemark"]');
            var remark = window.prompt('請輸入還原此揪團的操作異動說明：');

            if (remark === null) {
                e.preventDefault();
                return;
            }

            remark = remark.trim();
            if (!remark) {
                e.preventDefault();
                window.alert('請填寫操作異動說明。');
                return;
            }

            if (remark.length > 200) {
                remark = remark.substring(0, 200);
            }

            if (input) {
                input.value = remark;
            }

            return;
        }

        var remarkForm = e.target.closest('.operation-remark-form');
        if (!remarkForm) {
            return;
        }

        var textarea = remarkForm.querySelector('textarea[name="operationRemark"]');
        if (!textarea || !textarea.value.trim()) {
            e.preventDefault();
            window.alert('請填寫操作異動說明。');
            return;
        }

        e.preventDefault();

        fetch(remarkForm.getAttribute('action'), {
            method: 'POST',
            body: new FormData(remarkForm),
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error('儲存失敗');
                }

                return response.text();
            })
            .then(function (html) {
                var content = document.getElementById('groupDetailsContent');
                if (content) {
                    content.innerHTML = html;
                }
            })
            .catch(function () {
                HTMLFormElement.prototype.submit.call(remarkForm);
            });
    });

    (function () {
        var form = document.getElementById('groupFilterForm');
        if (!form) {
            return;
        }

        var debounceTimer;
        var baseUrl = form.getAttribute('action') || '@Url.Action("Index", "TravelGroups", new { area = "Admin" })';

        function submitFilter(delay) {
            window.clearTimeout(debounceTimer);
            debounceTimer = window.setTimeout(function () {
                var params = new URLSearchParams(new FormData(form));
                params.set('activePage', '1');
                params.set('abnormalPage', '1');
                params.set('deletedPage', '1');
                params.set('logPage', '1');

                loadGroupsRegion(baseUrl + '?' + params.toString());
            }, delay || 0);
        }

        if (window.flatpickr && document.getElementById('createdAtRange')) {
            flatpickr('#createdAtRange', {
                mode: 'range',
                dateFormat: 'Y-m-d',
                locale: flatpickr.l10ns.zh_tw,
                defaultDate: [
                    document.getElementById('createdAtFrom').value,
                    document.getElementById('createdAtTo').value
                ].filter(Boolean),
                onChange: function (selectedDates, dateStr, instance) {
                    var fromInput = document.getElementById('createdAtFrom');
                    var toInput = document.getElementById('createdAtTo');

                    fromInput.value = '';
                    toInput.value = '';

                    if (selectedDates.length >= 1) {
                        fromInput.value = instance.formatDate(selectedDates[0], 'Y-m-d');
                    }

                    if (selectedDates.length >= 2) {
                        toInput.value = instance.formatDate(selectedDates[1], 'Y-m-d');
                        submitFilter(0);
                    }
                },
                onClose: function (selectedDates) {
                    if (selectedDates.length === 0) {
                        document.getElementById('createdAtFrom').value = '';
                        document.getElementById('createdAtTo').value = '';
                        submitFilter(0);
                    }
                }
            });
        }

        form.addEventListener('change', function (e) {
            if (e.target.matches('select')) {
                submitFilter(0);
            }
        });

        form.addEventListener('input', function (e) {
            if (e.target.matches('input[name="keyword"]')) {
                submitFilter(500);
            }
        });
    })();
</script>
