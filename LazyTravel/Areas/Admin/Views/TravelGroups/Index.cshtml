@model LazyTravel.Models.ViewModels.TravelGroupAdminIndexViewModel

@{
    ViewData["Title"] = "揪團管理";
    // 這裡原本寫 ViewBag.DeletedGroups，但 Controller 從來沒有設定過這個 ViewBag，
    // 已刪除清單一直是空的；正確資料其實在 Model.DeletedGroups（強型別 ViewModel）裡。
    var deletedGroups = Model.DeletedGroups;

    // 分頁連結要帶著目前的篩選條件一起換頁，不然換頁後篩選就被清空了。
    // pageKey 是要換的那個頁碼參數（"activePage" 或 "deletedPage"），兩個清單各自分頁、互不影響對方頁碼。
    Dictionary<string, string> PageRoute(string pageKey, int pageValue)
    {
        var route = new Dictionary<string, string?>
        {
            ["tab"] = Model.Tab,
            ["keyword"] = Model.Keyword,
            ["country"] = Model.Country,
            ["region"] = Model.Region,
            ["ownerName"] = Model.OwnerName,
            ["joinRule"] = Model.JoinRule?.ToString(),
            ["groupStatus"] = Model.GroupStatus?.ToString(),
            ["reviewStatus"] = Model.ReviewStatus,
            ["isPublic"] = Model.IsPublic?.ToString(),
            ["startDateFrom"] = Model.StartDateFrom?.ToString("yyyy-MM-dd"),
            ["startDateTo"] = Model.StartDateTo?.ToString("yyyy-MM-dd"),
            ["createdAtFrom"] = Model.CreatedAtFrom?.ToString("yyyy-MM-dd"),
            ["createdAtTo"] = Model.CreatedAtTo?.ToString("yyyy-MM-dd"),
            ["activePage"] = Model.ActivePage.ToString(),
            ["deletedPage"] = Model.DeletedPage.ToString(),
        };
        route[pageKey] = pageValue.ToString();
        return route.Where(kv => kv.Value != null).ToDictionary(kv => kv.Key, kv => kv.Value!);
    }

    var activePrevRoute = PageRoute("activePage", Model.ActivePage - 1);
    var activeNextRoute = PageRoute("activePage", Model.ActivePage + 1);
    var deletedPrevRoute = PageRoute("deletedPage", Model.DeletedPage - 1);
    var deletedNextRoute = PageRoute("deletedPage", Model.DeletedPage + 1);
}

@section Breadcrumb {
    <li class="breadcrumb-item active" aria-current="page">揪團管理</li>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="admin-table-card mb-3">
    <form asp-area="Admin" asp-controller="TravelGroups" asp-action="Index" method="get" class="row g-2 align-items-end p-3">
        <input type="hidden" name="tab" value="@Model.Tab" />

        <div class="col-md-2">
            <label class="form-label small">關鍵字</label>
            <input type="text" name="keyword" class="form-control form-control-sm" value="@Model.Keyword" placeholder="房間名稱 / 說明">
        </div>
        <div class="col-md-2">
            <label class="form-label small">國家</label>
            <input type="text" name="country" class="form-control form-control-sm" value="@Model.Country">
        </div>
        <div class="col-md-2">
            <label class="form-label small">地區</label>
            <input type="text" name="region" class="form-control form-control-sm" value="@Model.Region">
        </div>
        <div class="col-md-2">
            <label class="form-label small">團主</label>
            <input type="text" name="ownerName" class="form-control form-control-sm" value="@Model.OwnerName">
        </div>
        <div class="col-md-2">
            <label class="form-label small">加入規則</label>
            <select name="joinRule" class="form-select form-select-sm">
                <option value="">全部</option>
                <option value="0" selected="@(Model.JoinRule == 0 ? "selected" : null)">直接加入</option>
                <option value="1" selected="@(Model.JoinRule == 1 ? "selected" : null)">需審核</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">揪團狀態</label>
            <select name="groupStatus" class="form-select form-select-sm">
                <option value="">全部</option>
                <option value="0" selected="@(Model.GroupStatus == 0 ? "selected" : null)">等待中</option>
                <option value="1" selected="@(Model.GroupStatus == 1 ? "selected" : null)">成行/進行中</option>
                <option value="2" selected="@(Model.GroupStatus == 2 ? "selected" : null)">結束</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">審核狀態</label>
            <select name="reviewStatus" class="form-select form-select-sm">
                <option value="">全部</option>
                <option value="正常" selected="@(Model.ReviewStatus == "正常" ? "selected" : null)">正常</option>
                <option value="檢舉審核中" selected="@(Model.ReviewStatus == "檢舉審核中" ? "selected" : null)">檢舉審核中</option>
                <option value="已下架" selected="@(Model.ReviewStatus == "已下架" ? "selected" : null)">已下架</option>
                <option value="違規" selected="@(Model.ReviewStatus == "違規" ? "selected" : null)">違規</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">是否公開</label>
            <select name="isPublic" class="form-select form-select-sm">
                <option value="">全部</option>
                <option value="true" selected="@(Model.IsPublic == true ? "selected" : null)">公開</option>
                <option value="false" selected="@(Model.IsPublic == false ? "selected" : null)">不公開</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">開始日期（起）</label>
            <input type="date" name="startDateFrom" class="form-control form-control-sm" value="@(Model.StartDateFrom?.ToString("yyyy-MM-dd"))">
        </div>
        <div class="col-md-2">
            <label class="form-label small">開始日期（迄）</label>
            <input type="date" name="startDateTo" class="form-control form-control-sm" value="@(Model.StartDateTo?.ToString("yyyy-MM-dd"))">
        </div>
        <div class="col-md-2">
            <label class="form-label small">建立時間（起）</label>
            <input type="date" name="createdAtFrom" class="form-control form-control-sm" value="@(Model.CreatedAtFrom?.ToString("yyyy-MM-dd"))">
        </div>
        <div class="col-md-2">
            <label class="form-label small">建立時間（迄）</label>
            <input type="date" name="createdAtTo" class="form-control form-control-sm" value="@(Model.CreatedAtTo?.ToString("yyyy-MM-dd"))">
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-sm btn-primary w-100">搜尋</button>
        </div>
        <div class="col-md-2">
            <a asp-area="Admin" asp-controller="TravelGroups" asp-action="Index" class="btn btn-sm btn-outline-secondary w-100">清除條件</a>
        </div>
    </form>
</div>

<h3>揪團清單</h3>

<div class="admin-table-card">
<table class="table table-hover">
    <thead>
        <tr>
            <th>操作</th>
            <th>編號</th>
            <th>房間名稱</th>
            <th>國家</th>
            <th>地區</th>
            <th>團主</th>
            <th>目前人數</th>
            <th>人數上限</th>
            <th>加入規則</th>
            <th>揪團狀態</th>
            <th>審核狀態</th>
            <th>公開</th>
            <th>建立時間</th>
            <th>房間內容</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ActiveGroups)
        {
            <tr ondblclick="location.href='@Url.Action("Details", "TravelGroups", new { area = "Admin", id = item.GroupId })'"
                style="cursor:pointer;">
                <td>
                    @if (item.ReviewStatus == "檢舉審核中" ||
                                    item.ReviewStatus == "已下架" ||
                                    item.ReviewStatus == "違規")
                    {
                        <form asp-area="Admin"
                              asp-controller="TravelGroups"
                              asp-action="Delete"
                              asp-route-id="@item.GroupId"
                              method="post"
                              onsubmit="return confirm('確定要將這筆揪團移至已刪除清單嗎？');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                        </form>
                    }
                </td>
                <td>@item.GroupId</td>
                <td>@item.GroupTitle</td>
                <td>@item.Country</td>
                <td>@item.Region</td>
                <td>@item.OwnerMember?.Name</td>
                <td>@item.CurrentPeople</td>
                <td>@item.MaxPeople</td>
                <td>@(item.JoinRule == 0 ? "直接加入" : "需審核")</td>
                <td>@(item.GroupStatus switch { 0 => "等待中", 1 => "成行/進行中", 2 => "結束", _ => "未知" })</td>
                <td>
                    @if (item.ReviewStatus == "檢舉審核中" || item.ReviewStatus == "已下架" || item.ReviewStatus == "違規")
                    {
                        <span class="status-pill status-risk">@item.ReviewStatus</span>
                    }
                    else
                    {
                        <span class="status-pill status-ok">@item.ReviewStatus</span>
                    }
                </td>
                <td>@(item.IsPublic ? "公開" : "不公開")</td>
                <td>@item.CreatedAt</td>
                <td>
                    <a asp-area="Admin"
                       asp-controller="TravelGroups"
                       asp-action="Details"
                       asp-route-id="@item.GroupId"
                       class="btn btn-sm btn-outline-primary">
                        詳細
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-secondary small">第 @Model.ActivePage / @(Model.ActiveTotalPages == 0 ? 1 : Model.ActiveTotalPages) 頁</span>
    <div>
        <a asp-area="Admin" asp-controller="TravelGroups" asp-action="Index"
           asp-all-route-data="activePrevRoute"
           class="btn btn-sm btn-outline-secondary @(Model.ActivePage <= 1 ? "disabled" : "")">上一頁</a>
        <a asp-area="Admin" asp-controller="TravelGroups" asp-action="Index"
           asp-all-route-data="activeNextRoute"
           class="btn btn-sm btn-outline-secondary @(Model.ActivePage >= Model.ActiveTotalPages ? "disabled" : "")">下一頁</a>
    </div>
</div>

<hr />

<h3>已刪除清單</h3>

<div class="admin-table-card">
<table class="table table-hover table-secondary">
    <thead>
        <tr>
            <th>操作</th>
            <th>編號</th>
            <th>房間名稱</th>
            <th>國家</th>
            <th>地區</th>
            <th>團主</th>
            <th>目前人數</th>
            <th>人數上限</th>
            <th>加入規則</th>
            <th>揪團狀態</th>
            <th>審核狀態</th>
            <th>公開</th>
            <th>建立時間</th>
            <th>房間內容</th>
        </tr>
    </thead>
    <tbody>
        @if (deletedGroups != null && deletedGroups.Any())
        {
            foreach (var item in deletedGroups)
            {
                <tr ondblclick="location.href='@Url.Action("Details", "TravelGroups", new { area = "Admin", id = item.GroupId })'"
                    style="cursor:pointer;">
                    <td>
                        <form asp-area="Admin"
                              asp-controller="TravelGroups"
                              asp-action="Restore"
                              asp-route-id="@item.GroupId"
                              method="post"
                              onsubmit="return confirm('確定要還原這筆揪團嗎？');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-primary">還原</button>
                        </form>
                    </td>
                    <td>@item.GroupId</td>
                    <td>@item.GroupTitle</td>
                    <td>@item.Country</td>
                    <td>@item.Region</td>
                    <td>@item.OwnerMember?.Name</td>
                    <td>@item.CurrentPeople</td>
                    <td>@item.MaxPeople</td>
                    <td>@(item.JoinRule == 0 ? "直接加入" : "需審核")</td>
                    <td>@(item.GroupStatus switch { 0 => "等待中", 1 => "成行/進行中", 2 => "結束", _ => "未知" })</td>
                    <td>
                        @if (item.ReviewStatus == "檢舉審核中" || item.ReviewStatus == "已下架" || item.ReviewStatus == "違規")
                        {
                            <span class="status-pill status-risk">@item.ReviewStatus</span>
                        }
                        else
                        {
                            <span class="status-pill status-ok">@item.ReviewStatus</span>
                        }
                    </td>
                    <td>@(item.IsPublic ? "公開" : "不公開")</td>
                    <td>@item.CreatedAt</td>
                    <td>
                        <a asp-area="Admin"
                           asp-controller="TravelGroups"
                           asp-action="Details"
                           asp-route-id="@item.GroupId"
                           class="btn btn-sm btn-outline-primary">
                            詳細
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="14" class="text-center">目前沒有已刪除資料</td>
            </tr>
        }
    </tbody>
</table>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-secondary small">第 @Model.DeletedPage / @(Model.DeletedTotalPages == 0 ? 1 : Model.DeletedTotalPages) 頁</span>
    <div>
        <a asp-area="Admin" asp-controller="TravelGroups" asp-action="Index"
           asp-all-route-data="deletedPrevRoute"
           class="btn btn-sm btn-outline-secondary @(Model.DeletedPage <= 1 ? "disabled" : "")">上一頁</a>
        <a asp-area="Admin" asp-controller="TravelGroups" asp-action="Index"
           asp-all-route-data="deletedNextRoute"
           class="btn btn-sm btn-outline-secondary @(Model.DeletedPage >= Model.DeletedTotalPages ? "disabled" : "")">下一頁</a>
    </div>
</div>
