           href="@BuildPageUrl("active", Model.ActivePage, Model.AbnormalPage, Model.DeletedPage, Model.LogPage)">
            所有揪團清單 <span class="tab-count">@Model.TotalGroupsCount</span>
        </a>
    </li>

    <li class="nav-item" role="presentation">
        <a class="nav-link ajax-nav-link @abnormalTabClass"
           href="@BuildPageUrl("abnormal", Model.ActivePage, Model.AbnormalPage, Model.DeletedPage, Model.LogPage)">
            異常揪團清單 <span class="tab-count">@Model.AbnormalGroupsCount</span>
        </a>
    </li>

    <li class="nav-item" role="presentation">
        <a class="nav-link ajax-nav-link @deletedTabClass"
           href="@BuildPageUrl("deleted", Model.ActivePage, Model.AbnormalPage, Model.DeletedPage, Model.LogPage)">
            已刪除清單 <span class="tab-count">@Model.DeletedGroupsCount</span>
        </a>
