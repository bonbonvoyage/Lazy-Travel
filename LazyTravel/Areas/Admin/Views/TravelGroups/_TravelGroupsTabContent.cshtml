@model LazyTravel.Models.ViewModels.TravelGroupAdminIndexViewModel

@{
    bool IsTab(string tab) => Model.Tab == tab;
    string activeTabClass = IsTab("deleted") || IsTab("log") || IsTab("abnormal") ? "" : "active";
    string activePaneClass = IsTab("deleted") || IsTab("log") || IsTab("abnormal") ? "tab-pane fade" : "tab-pane fade show active";

    string abnormalTabClass = IsTab("abnormal") ? "active" : "";
    string abnormalPaneClass = IsTab("abnormal") ? "tab-pane fade show active" : "tab-pane fade";

    string deletedTabClass = IsTab("deleted") ? "active" : "";
    string deletedPaneClass = IsTab("deleted") ? "tab-pane fade show active" : "tab-pane fade";

    string logTabClass = IsTab("log") ? "active" : "";
    string logPaneClass = IsTab("log") ? "tab-pane fade show active" : "tab-pane fade";

    string BuildPageUrl(string tab, int activePage, int abnormalPage, int deletedPage, int logPage)
    {
        var query = new List<string>();

        void Add(string name, string? value)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                query.Add($"{name}={Uri.EscapeDataString(value)}");
            }
        }

        Add("tab", tab);
        Add("keyword", Model.Keyword);

        if (Model.CreatedAtFrom.HasValue)
        {
            Add("createdAtFrom", Model.CreatedAtFrom.Value.ToString("yyyy-MM-dd"));
        }

        if (Model.CreatedAtTo.HasValue)
        {
            Add("createdAtTo", Model.CreatedAtTo.Value.ToString("yyyy-MM-dd"));
        }

        Add("selectedReviewStatus", Model.SelectedReviewStatus);
        Add("sortOrder", Model.SortOrder);
        Add("activePage", activePage.ToString());
        Add("abnormalPage", abnormalPage.ToString());
        Add("deletedPage", deletedPage.ToString());
        Add("logPage", logPage.ToString());

        return Url.Action("Index", "TravelGroups", new { area = "Admin" }) + "?" + string.Join("&", query);
    }

    (int Start, int End) GetPageWindow(int currentPage, int totalPages)
    {
        const int maxVisiblePages = 10;

        if (totalPages <= maxVisiblePages)
        {
            return (1, totalPages);
        }

        var halfWindow = maxVisiblePages / 2;
        var start = currentPage - halfWindow + 1;

        if (start < 1)
        {
            start = 1;
        }

        var end = start + maxVisiblePages - 1;

        if (end > totalPages)
        {
            end = totalPages;
            start = end - maxVisiblePages + 1;
        }

        return (start, end);
    }
}

