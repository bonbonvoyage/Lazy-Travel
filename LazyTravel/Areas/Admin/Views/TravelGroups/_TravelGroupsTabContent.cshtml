                    @{
                        var activePageWindow = GetPageWindow(Model.ActivePage, Model.ActiveTotalPages);
                    }

                    @for (int i = activePageWindow.Start; i <= activePageWindow.End; i++)
                    {
                        <li class="page-item @(Model.ActivePage == i ? "active" : "")">
                            <a class="page-link ajax-nav-link"
                               href="@BuildPageUrl("active", i, Model.AbnormalPage, Model.DeletedPage, Model.LogPage)">
                                @i
