@model LazyTravel.Models.TravelGroup

@{
    ViewData["Title"] = "揪團詳細內容";
}

<h1>揪團詳細內容</h1>

<table class="table table-bordered">
    <tr>
        <th>編號</th>
        <td>@Model.GroupId</td>
    </tr>
    <tr>
        <th>房間名稱</th>
        <td>@Model.GroupTitle</td>
    </tr>
    <tr>
        <th>國家</th>
        <td>@Model.Country</td>
    </tr>
    <tr>
        <th>地區</th>
        <td>@Model.Region</td>
    </tr>
    <tr>
        <th>團主</th>
        <td>@Model.OwnerMember?.Name</td>
    </tr>
    <tr>
        <th>團內成員</th>
        <td>
            @if (Model.GroupMembers != null && Model.GroupMembers.Any())
            {
                <ul>
                    @foreach (var member in Model.GroupMembers.Where(m => m.IsRemoved == false && m.LeftAt == null))
                    {
                        <li>
                            @member.Member?.Name
                            （@member.MemberRole）
                        </li>
                    }
                </ul>
            }
            else
            {
                <span>目前無成員資料</span>
            }
        </td>
    </tr>
    <tr>
        <th>目前人數</th>
        <td>@Model.CurrentPeople</td>
    </tr>
    <tr>
        <th>最少成行人數</th>
        <td>@Model.MinPeople</td>
    </tr>
    <tr>
        <th>人數上限</th>
        <td>@Model.MaxPeople</td>
    </tr>
    <tr>
        <th>加入規則</th>
        <td>@Model.JoinRule</td>
    </tr>
    <tr>
        <th>揪團狀態</th>
        <td>@Model.GroupStatus</td>
    </tr>
    <tr>
        <th>審核狀態</th>
        <td>@Model.ReviewStatus</td>
    </tr>
    <tr>
        <th>是否公開</th>
        <td>@(Model.IsPublic ? "公開" : "不公開")</td>
    </tr>
    <tr>
        <th>建立時間</th>
        <td>@Model.CreatedAt</td>
    </tr>
    <tr>
        <th>更新時間</th>
        <td>@Model.UpdatedAt</td>
    </tr>
</table>

<a asp-area="Admin"
   asp-controller="TravelGroups"
   asp-action="Index"
   class="btn btn-secondary">
    返回列表
</a>

