@model LazyTravel.Models.TravelGroup

@{
    ViewData["Title"] = "揪團詳細內容";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-action="Index">揪團管理</a></li>
    <li class="breadcrumb-item active" aria-current="page">@Model.GroupTitle</li>
}

<div class="admin-table-card">
<table class="table">
    <tr>
        <th>編號</th>
        <td>@Model.GroupId</td>
    </tr>
    <tr>
        <th>房間名稱</th>
        <td>@Model.GroupTitle</td>
    </tr>
    <tr>
        <th>國家</th>
        <td>@Model.Country</td>
    </tr>
    <tr>
        <th>地區</th>
        <td>@Model.Region</td>
    </tr>
    <tr>
        <th>團主</th>
        <td>@Model.OwnerMember?.Name</td>
    </tr>
    <tr>
        <th>團內成員</th>
        <td>
            @if (Model.GroupMembers != null && Model.GroupMembers.Any())
            {
                <ul>
                    @foreach (var member in Model.GroupMembers.Where(m => m.IsRemoved == false && m.LeftAt == null))
                    {
                        <li>
                            @member.Member?.Name
                            （@(member.MemberRole == 1 ? "團主" : "一般成員")）
                        </li>
                    }
                </ul>
            }
            else
            {
                <span>目前無成員資料</span>
            }
        </td>
    </tr>
    <tr>
        <th>目前人數</th>
        <td>@Model.CurrentPeople</td>
    </tr>
    <tr>
        <th>最少成行人數</th>
        <td>@Model.MinPeople</td>
    </tr>
    <tr>
        <th>人數上限</th>
        <td>@Model.MaxPeople</td>
    </tr>
    <tr>
        <th>加入規則</th>
        <td>@(Model.JoinRule == 0 ? "直接加入" : "需審核")</td>
    </tr>
    <tr>
        <th>揪團狀態</th>
        <td>@(Model.GroupStatus switch { 0 => "等待中", 1 => "成行/進行中", 2 => "結束", _ => "未知" })</td>
    </tr>
    <tr>
        <th>審核狀態</th>
        <td>
            @if (Model.ReviewStatus == "檢舉審核中" || Model.ReviewStatus == "已下架" || Model.ReviewStatus == "違規")
            {
                <span class="status-pill status-risk">@Model.ReviewStatus</span>
            }
            else
            {
                <span class="status-pill status-ok">@Model.ReviewStatus</span>
            }
        </td>
    </tr>
    <tr>
        <th>是否公開</th>
        <td>@(Model.IsPublic ? "公開" : "不公開")</td>
    </tr>
    <tr>
        <th>建立時間</th>
        <td>@Model.CreatedAt</td>
    </tr>
    <tr>
        <th>更新時間</th>
        <td>@Model.UpdatedAt</td>
    </tr>
</table>
</div>

<a asp-area="Admin"
   asp-controller="TravelGroups"
   asp-action="Index"
   class="btn btn-outline-primary mt-3">
    返回列表
</a>

