<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LazyTravel 後台管理</title>

    @* 字型 *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=LXGW+WenKai+TC&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">

    @* 樣式：Bootstrap → 品牌色 → 後台專用 *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
    <div class="admin-wrapper">

        @* ── 左側選單 ── *@
        <aside class="admin-sidebar" id="adminSidebar">

            @* LOGO，點了回後台首頁 *@
            <a class="sidebar-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">LazyTravel 後台</a>

            <nav class="nav">
                @* 判斷目前在哪個頁面，自動幫對應連結加上 active（選中）樣式 *@
                @{
                    var currentController = (string?)ViewContext.RouteData.Values["controller"];
                    string NavActive(string controller) =>
                    string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
                }

                @* 🌟 1. 注入 ASP.NET Core 內建的授權服務 *@
                @inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService

                @* 🌟 2. 事先判斷各項目的細粒度權限，以決定是否要顯示大標籤與子項目 *@
                @{
                    bool canSeeDashboard = (await AuthorizationService.AuthorizeAsync(User, null, "RequireDashboardRead")).Succeeded;

                    bool canSeeMembers = (await AuthorizationService.AuthorizeAsync(User, null, "RequireMemberRead")).Succeeded;
                    bool canSeeReports = (await AuthorizationService.AuthorizeAsync(User, null, "RequireReportRead")).Succeeded;

                    bool canSeeVlogs = (await AuthorizationService.AuthorizeAsync(User, null, "RequireVlogRead")).Succeeded;
                    bool canSeeForums = (await AuthorizationService.AuthorizeAsync(User, null, "RequireForumRead")).Succeeded;
                    bool canSeeTravelGroups = (await AuthorizationService.AuthorizeAsync(User, null, "RequireTravelGroupRead")).Succeeded;

                    bool canSeePlans = (await AuthorizationService.AuthorizeAsync(User, null, "RequirePlanRead")).Succeeded;
                    bool canSeeSplits = (await AuthorizationService.AuthorizeAsync(User, null, "RequireSplitRead")).Succeeded;
                    bool canSeeAnalytics = (await AuthorizationService.AuthorizeAsync(User, null, "RequireAnalyticsRead")).Succeeded;

                    bool canSeeNotifications = (await AuthorizationService.AuthorizeAsync(User, null, "RequireNotificationRead")).Succeeded;

                    bool canSeeEmployees = (await AuthorizationService.AuthorizeAsync(User, null, "RequireEmployeeRead")).Succeeded;
                    bool canSeeRoles = (await AuthorizationService.AuthorizeAsync(User, null, "RequireRoleManage")).Succeeded;
                }

                @* ── 動態渲染導覽列 ── *@

                @if (canSeeDashboard)
                {
                    <a class="nav-link @NavActive("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">總覽</a>
                }

                @* 🌟 群組一：會員與審核中心 *@
                @if (canSeeMembers || canSeeReports)
                {
                    <div class="nav-group-label">會員與審核中心</div>
                    if (canSeeMembers)
                    {

                        <a class="nav-link @NavActive("Members")" asp-area="Admin" asp-controller="Members" asp-action="Index">會員管理</a>
                    }
                    if (canSeeReports)
                    {

                        <a class="nav-link @NavActive("Reports")" asp-area="Admin" asp-controller="Reports" asp-action="Index">檢舉處理</a>
                    }
                }

                @* 🌟 群組二：社群內容管理 *@
                @if (canSeeVlogs || canSeeForums || canSeeTravelGroups)
                {
                    <div class="nav-group-label">社群內容管理</div>
                    if (canSeeVlogs)
                    {

                        <a class="nav-link @NavActive("VlogPosts")" asp-area="Admin" asp-controller="VlogPosts" asp-action="Index">Vlog 行程文章</a>
                    }
                    if (canSeeForums)
                    {

                        <a class="nav-link @NavActive("Forum")" asp-area="Admin" asp-controller="Forum" asp-action="Index">論壇管理</a>
                    }
                    if (canSeeTravelGroups)
                    {

                        <a class="nav-link @NavActive("TravelGroups")" asp-area="Admin" asp-controller="TravelGroups" asp-action="Index">揪團管理</a>
                    }
                }

                @* 🌟 群組三：財務與數據 *@
                @if (canSeePlans || canSeeSplits || canSeeAnalytics)
                {
                    <div class="nav-group-label">財務與數據</div>
                    if (canSeePlans)
                    {

                        <a class="nav-link @NavActive("Subscriptions")" asp-area="Admin" asp-controller="Subscriptions" asp-action="Index">訂閱方案</a>
                    }
                    if (canSeeSplits)
                    {

                        <a class="nav-link @NavActive("ExpenseSplits")" asp-area="Admin" asp-controller="ExpenseSplits" asp-action="Index">分帳管理</a>
                    }
                    if (canSeeAnalytics)
                    {

                        <a class="nav-link @NavActive("Analytics")" asp-area="Admin" asp-controller="Analytics" asp-action="Index">數據分析</a>
                    }
                }

                @* 🌟 群組四：系統 *@
                @if (canSeeNotifications)
                {
                    <div class="nav-group-label">系統</div>
                    <a class="nav-link @NavActive("Notifications")" asp-area="Admin" asp-controller="Notifications" asp-action="Index">公告與通知</a>
                }

                @* 🌟 群組五：內部管理 *@
                @if (canSeeEmployees || canSeeRoles)
                {
                    <div class="nav-group-label">內部管理</div>
                    if (canSeeEmployees)
                    {

                        <a class="nav-link @NavActive("Employees")" asp-area="Admin" asp-controller="Employees" asp-action="Index">員工管理</a>
                    }
                    if (canSeeRoles)
                    {

                        <a class="nav-link @NavActive("Roles")" asp-area="Admin" asp-controller="Roles" asp-action="Index">權限(角色)管理</a>
                    }
                }

            </nav>

            <div class="sidebar-footer">LazyTravel v1.2.1</div>
        </aside>

        @* ── 右側主內容 ── *@
        <div class="admin-main">

            @* 頂欄：頁面標題 + 登入者名稱 + 登出按鈕 *@
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-2">
                    @* 手機版才會出現的開關選單按鈕 *@
                    <button class="btn btn-sm btn-outline-primary d-lg-none" type="button"
                            onclick="document.getElementById('adminSidebar').classList.toggle('show')">
                        選單
                    </button>
                    <h1 class="page-title">@ViewData["Title"]</h1>
                </div>
                <!-- 🌟 更新後的使用者狀態與安全登出按鈕 -->
                <div class="d-flex align-items-center gap-3">
                    <span class="text-secondary small fw-bold">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @User.Identity.Name
                        }
                        else
                        {
                            @:未登入
                        }
                    </span>
                    <img class="rounded-circle border"
                         src="https://ui-avatars.com/api/?name=@(User.Identity?.Name ?? "U")&background=0284c7&color=fff&size=32"
                         alt="Avatar" style="width: 32px; height: 32px; object-fit: cover;">

                    <!-- 指向剛建好的 AuthController 的 Logout 動作 -->
                    <form asp-area="Admin" asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-danger shadow-sm">
                            <i class="fas fa-sign-out-alt me-1"></i> 登出
                        </button>
                    </form>
                </div>
            </header>

            @* 麵包屑（路徑提示，例：後台 > 揪團管理）
           各頁面可自訂 @section Breadcrumb，沒設定就顯示頁面標題 *@
            <div class="admin-breadcrumb">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">後台</a></li>
                        @if (IsSectionDefined("Breadcrumb"))
                        {
                            @await RenderSectionAsync("Breadcrumb")
                        }
                        else
                        {
                            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                        }
                    </ol>
                </nav>
            </div>

            @* 各頁面的內容放這裡 *@
            <main class="admin-content">
                @RenderBody()
            </main>

        </div>
    </div>

    <!-- 🌟 關鍵修復：請把這行 jQuery 補在這裡！(必須在 bootstrap 之前) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
