@model LazyTravel.Models.DTOs.MemberDetailDto

@{
    ViewData["Title"] = "會員詳細資料與處分";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    // 從 Controller 傳過來的 Edit DTO
    var editDto = ViewBag.EditDto as LazyTravel.Models.DTOs.MemberEditDto;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 text-gray-800">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-2">
            <i class="fas fa-arrow-left"></i> 返回列表
        </a>
        會員詳細資料：@Model.Name
    </h2>
</div>

<!-- 顯示操作成功或失敗的提示訊息 -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <!-- 左側：1.2 會員資料檢視 (唯讀供查核，加入智慧遮罩) -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0"><i class="fas fa-user-circle me-2"></i>基本與聯絡資訊 (共5項)</h5>
            </div>
            <div class="card-body">
                <div class="text-center mb-4">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="大頭貼" class="rounded-circle img-thumbnail" style="width: 120px; height: 120px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/120?text=No+Image'" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center text-white" style="width: 120px; height: 120px; font-size: 3rem;">
                            <i class="fas fa-user"></i>
                        </div>
                    }
                </div>

                <table class="table table-bordered table-sm align-middle">
                    <tbody>
                        <tr>
                            <th class="w-25 bg-light">會員編號</th>
                            <td>@Model.MemberID</td>
                        </tr>
                        <tr>
                            <th class="bg-light">真實姓名/暱稱</th>
                            <td>@Model.Name</td>
                        </tr>
                        <tr>
                            <th class="bg-light">註冊時間</th>
                            <td>@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm:ss")</td>
                        </tr>
                        <tr>
                            <th class="bg-light">個人簡介</th>
                            <td>@(string.IsNullOrEmpty(Model.Bio) ? Html.Raw("<span class='text-muted'>未填寫</span>") : Model.Bio)</td>
                        </tr>
                        
                        <!-- 5大聯絡方式與社群欄位 -->
                        <tr class="table-secondary">
                            <td colspan="2" class="fw-bold text-center">通訊錄與社群綁定</td>
                        </tr>
                        <tr>
                            <th class="bg-light">1. 登入信箱</th>
                            <td>
                                @Model.Email
                                @if (Model.IsEmailConfirmed)
                                {
                                    <span class="badge bg-success ms-1"><i class="fas fa-check"></i> 已驗證</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark ms-1">未驗證</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">2. 聯絡電話</th>
                            <td>
                                @if (string.IsNullOrEmpty(Model.Phone))
                                {
                                    <span class="text-muted">未填寫</span>
                                }
                                else
                                {
                                    @Model.Phone 
                                    <span class="badge bg-secondary ms-1" title="基於資安考量已遮罩">保護中</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">3. Line ID</th>
                            <td>
                                @if (string.IsNullOrEmpty(Model.LineId))
                                {
                                    <span class="text-muted">未綁定</span>
                                }
                                else if (Model.LineId.Contains("***"))
                                {
                                    @Model.LineId <span class="badge bg-secondary ms-1" title="基於資安考量已遮罩">保護中</span>
                                }
                                else
                                {
                                    @Model.LineId
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">4. Instagram</th>
                            <td>
                                @if (string.IsNullOrEmpty(Model.InstagramUrl))
                                {
                                    <span class="text-muted">未綁定</span>
                                }
                                else if (Model.InstagramUrl.Contains("***"))
                                {
                                    @Model.InstagramUrl <span class="badge bg-secondary ms-1" title="基於資安考量已遮罩">保護中</span>
                                }
                                else
                                {
                                    <a href="@Model.InstagramUrl" target="_blank" class="text-decoration-none">
                                        <i class="fab fa-instagram text-danger"></i> 前往查看
                                    </a>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">5. Facebook</th>
                            <td>
                                @if (string.IsNullOrEmpty(Model.FacebookUrl))
                                {
                                    <span class="text-muted">未綁定</span>
                                }
                                else if (Model.FacebookUrl.Contains("***"))
                                {
                                    @Model.FacebookUrl <span class="badge bg-secondary ms-1" title="基於資安考量已遮罩">保護中</span>
                                }
                                else
                                {
                                    <a href="@Model.FacebookUrl" target="_blank" class="text-decoration-none">
                                        <i class="fab fa-facebook text-primary"></i> 前往查看
                                    </a>
                                }
                            </td>
                        </tr>

                        <!-- 訂閱方案與登入稽核 -->
                        <tr class="table-primary">
                            <td colspan="2" class="fw-bold text-center">方案與系統狀態</td>
                        </tr>
                        <tr>
                            <th class="bg-light">目前方案</th>
                            <td>
                                <span class="badge bg-primary">@Model.CurrentPlanName</span>
                                @if (Model.PlanExpiryDate.HasValue)
                                {
                                    <small class="text-muted ms-2">到期日: @Model.PlanExpiryDate.Value.ToString("yyyy/MM/dd")</small>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">最後登入時間</th>
                            <td>
                                @if (Model.LastLoginAt.HasValue)
                                {
                                    @Model.LastLoginAt.Value.ToString("yyyy/MM/dd HH:mm:ss")
                                }
                                else
                                {
                                    <span class="text-muted">無登入紀錄</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">最近登入 IP</th>
                            <td>
                                @if (string.IsNullOrEmpty(Model.LastLoginIp))
                                {
                                    <span class="text-muted">無紀錄</span>
                                }
                                else
                                {
                                    <span class="font-monospace">@Model.LastLoginIp</span>
                                    <a href="https://ipinfo.io/@Model.LastLoginIp" target="_blank" class="btn btn-sm btn-link p-0 ms-2 text-decoration-none" title="查詢 IP 來源">
                                        <i class="fas fa-map-marker-alt text-danger"></i> 查位置
                                    </a>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 右側：1.3 會員資料處分與停權管制 -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm h-100 border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0"><i class="fas fa-gavel me-2"></i>資料處置與帳號管制</h5>
            </div>
            <div class="card-body">
                <!-- 編輯表單開始 -->
                <form asp-action="Edit" method="post">
                    <!-- 隱藏欄位傳遞 ID -->
                    <input type="hidden" asp-for="@editDto.MemberID" name="MemberID" />

                    <!-- 重置違規資料區塊 -->
                    <div class="mb-4 border border-warning p-3 rounded bg-light">
                        <label class="form-label fw-bold text-warning text-darken mb-1"><i class="fas fa-eraser me-1"></i>強制重置違規資料</label>
                        <div class="form-text mb-3">勾選後，該欄位資料將被系統清空或改為預設值，並要求會員重新填寫。</div>

                        <div class="form-check mb-2">
                            <input asp-for="@editDto.ResetName" class="form-check-input border-secondary" type="checkbox" name="ResetName" id="resetName">
                            <label class="form-check-label text-dark" for="resetName">
                                強制重置 <strong>姓名/暱稱</strong> (將變更為「違規暱稱_請修改」)
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input asp-for="@editDto.ResetBio" class="form-check-input border-secondary" type="checkbox" name="ResetBio" id="resetBio">
                            <label class="form-check-label text-dark" for="resetBio">
                                強制清空 <strong>個人簡介</strong>
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input asp-for="@editDto.RemoveAvatar" class="form-check-input border-secondary" type="checkbox" name="RemoveAvatar" id="removeAvatar">
                            <label class="form-check-label text-dark" for="removeAvatar">
                                強制移除 <strong>大頭貼</strong> (回復預設頭像)
                            </label>
                        </div>
                    </div>

                    <!-- 帳號停權區塊 -->
                    <div class="mb-4 border p-3 rounded bg-light">
                        <label asp-for="@editDto.Status" class="form-label fw-bold text-danger"><i class="fas fa-ban me-1"></i>帳號管制狀態</label>
                        <select asp-for="@editDto.Status" name="Status" class="form-select border-danger">
                            <option value="1">🟢 正常啟用</option>
                            <option value="2">🔴 強制停權 (鎖定發文與互動權限)</option>
                        </select>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="@editDto.SendNotification" class="form-check-input" type="checkbox" name="SendNotification" id="sendNotifyCheck" checked>
                        <label class="form-check-label fw-bold text-primary" for="sendNotifyCheck">
                            發送系統通知信告知會員 (包含處分原因)
                        </label>
                    </div>

                    <div class="mb-4">
                        <label asp-for="@editDto.AdminReason" class="form-label fw-bold text-danger">操作原因 (必填稽核用) *</label>
                        <input asp-for="@editDto.AdminReason" name="AdminReason" class="form-control" placeholder="例如：大頭貼及簡介涉及不雅內容，強制移除" required />
                        <span asp-validation-for="@editDto.AdminReason" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-save me-1"></i> 執行處分並寫入稽核紀錄
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- 載入前端驗證腳本 -->
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}