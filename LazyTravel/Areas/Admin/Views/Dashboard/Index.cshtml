@model LazyTravel.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "總覽";
}

<div class="dash-notice">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 01-3.4 0" /></svg>
    <div>
        <div class="dash-notice-eyebrow">公告</div>
        <div>@Model.NoticeMessage</div>
    </div>
</div>

@{
    var moduleIcons = new Dictionary<string, string>
    {
        ["member"] = "<circle cx=\"12\" cy=\"8\" r=\"3.4\" /><path d=\"M5 20c0-3.6 3.1-6.2 7-6.2s7 2.6 7 6.2\" />",
        ["article"] = "<rect x=\"4\" y=\"4\" width=\"16\" height=\"12\" rx=\"2\" /><path d=\"M9 20h6M12 16v4\" />",
        ["group"] = "<path d=\"M4 19V7l8-4 8 4v12\" /><path d=\"M9 19v-6h6v6\" />",
        ["report"] = "<path d=\"M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z\" /><path d=\"M9.5 12l1.8 1.8L14.5 10\" />",
    };
}

@if (!Model.Modules.Any())
{
    <div class="dash-mod-none">你目前的權限尚未開放任何管理模組,請聯絡系統管理員。</div>
}

<div class="dash-mod-grid">
    @foreach (var module in Model.Modules)
    {
        <a class="dash-mod-card" href="@module.Href">
            @if (module.Badge is int badge)
            {
                <span class="dash-mod-badge">@badge</span>
            }
            <div class="dash-mod-icon dash-ic-@module.ColorKey">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">@Html.Raw(moduleIcons[module.ColorKey])</svg>
            </div>
            <div class="dash-mod-name">@module.Label</div>
            <div class="dash-mod-meta"><b>@module.StatValue</b> @module.StatLabel</div>
            <div class="dash-mod-log">
                <div class="dash-log-eyebrow">最近動作</div>
                @if (module.RecentLogs.Any())
                {
                    foreach (var log in module.RecentLogs)
                    {
                        <div class="dash-log-row"><span class="dash-log-t">@log.CreatedAt.ToString("MM/dd")</span>@log.Action:@log.Detail</div>
                    }
                }
                else
                {
                    <div class="dash-log-empty">尚無操作紀錄</div>
                }
            </div>
        </a>
    }
</div>

@section Styles {
    <style>
        .dash-notice {
            background: linear-gradient(135deg, var(--sea-800), var(--sea-600));
            color: #fff;
            border-radius: var(--radius-lg);
            padding: 1.2rem 1.4rem;
            margin-bottom: 1.1rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .dash-notice svg { width: 34px; height: 34px; flex-shrink: 0; opacity: .9; }
        .dash-notice-eyebrow { font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; opacity: .75; }

        /* auto-fit:卡片被權限濾掉時自動收合欄數,不會留一排空格 */
        .dash-mod-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: .9rem; }
        @@media (max-width: 900px) { .dash-mod-grid { grid-template-columns: repeat(2, 1fr); } }

        .dash-mod-none {
            background: var(--surface-alt); border-radius: var(--radius-lg);
            padding: 2rem 1.4rem; text-align: center;
            font-size: .88rem; color: var(--text-secondary);
        }

        .dash-mod-card {
            position: relative;
            background: var(--surface-alt);
            border-radius: var(--radius-lg);
            padding: 1.25rem 1.1rem 1rem;
            text-decoration: none;
            color: var(--ink);
            display: flex;
            flex-direction: column;
            gap: .6rem;
            transition: transform .18s ease, box-shadow .18s ease;
        }
        .dash-mod-card:hover { transform: translateY(-3px); box-shadow: 0 4px 20px rgba(31,61,78,.1); }

        .dash-mod-icon {
            width: 38px; height: 38px; border-radius: var(--radius-sm);
            display: flex; align-items: center; justify-content: center;
            background: var(--surface);
        }
        .dash-mod-icon svg { width: 20px; height: 20px; }
        .dash-ic-member { color: var(--sea-600); }
        .dash-ic-article { color: var(--leaf-600); }
        .dash-ic-group { color: var(--sand-500); }
        .dash-ic-report { color: var(--coral-600); }

        .dash-mod-name { font-family: var(--font-display); font-size: 1.02rem; font-weight: 600; color: var(--sea-800); }
        .dash-mod-meta { font-size: .8rem; color: var(--text-secondary); }
        .dash-mod-meta b { font-size: 1.3rem; font-variant-numeric: tabular-nums; color: var(--sea-800); }
        .dash-mod-badge {
            position: absolute; top: 1rem; right: 1rem;
            border-radius: var(--radius-pill); padding: .18rem .6rem;
            font-size: .72rem; font-weight: 700;
            background: var(--coral-600); color: #fff;
        }

        .dash-mod-log { margin-top: .1rem; padding-top: .6rem; border-top: 1px solid var(--border-soft); display: flex; flex-direction: column; gap: .4rem; }
        .dash-log-eyebrow { font-size: .68rem; letter-spacing: .05em; text-transform: uppercase; color: var(--text-muted); }
        .dash-log-row { font-size: .78rem; line-height: 1.5; color: var(--text-secondary); }
        .dash-log-t { color: var(--text-muted); font-variant-numeric: tabular-nums; margin-right: .35rem; }
        .dash-log-empty { font-size: .78rem; color: var(--text-muted); }
    </style>
}
