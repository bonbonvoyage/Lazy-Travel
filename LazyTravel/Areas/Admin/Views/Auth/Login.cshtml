@model LazyTravel.Models.DTOs.AdminLoginDto
@{
    Layout = null; // 登入頁不需要用到側邊欄 Layout
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>後台登入 - LazyTravel 企業管理系統</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        body {
            background-color: #f4f6f9;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .login-card {
            background: #fff;
            border-radius: 1rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            overflow: hidden;
            width: 100%;
            max-width: 900px;
            display: flex;
        }
        .login-image {
            background: linear-gradient(135deg, #0284c7 0%, #38bdf8 100%);
            flex: 1;
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            padding: 3rem;
            text-align: center;
        }
        @@media (min-width: 768px) {
            .login-image { display: flex; }
        }
        .login-form-container {
            flex: 1;
            padding: 4rem 3rem;
        }
        .form-control {
            padding: 0.8rem 1rem;
            border-radius: 0.5rem;
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
        }
        .form-control:focus {
            background-color: #fff;
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
        }
        .btn-login {
            background-color: #0284c7;
            color: white;
            padding: 0.8rem;
            border-radius: 0.5rem;
            font-weight: 600;
            width: 100%;
            margin-top: 1.5rem;
        }
        .btn-login:hover {
            background-color: #0369a1;
            color: white;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <!-- 左側品牌視覺 -->
        <div class="login-image">
            <i class="fas fa-plane-departure mb-4" style="font-size: 4rem;"></i>
            <h2 class="fw-bold mb-3">LazyTravel</h2>
            <!--<p class="mb-0" style="opacity: 0.8;">企業級旅遊平台後台管理系統<br>RBAC 安全防護核心</p>-->
        </div>

        <!-- 右側登入表單 -->
        <div class="login-form-container">
            <h3 class="fw-bold text-dark mb-1">員工登入</h3>
            <p class="text-muted mb-4 small">請輸入您的企業信箱與密碼</p>

            <form asp-action="Login" method="post" id="loginForm">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-bold"></div>

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-bold">企業信箱</label>
                    <input asp-for="Email" class="form-control" id="emailInput" placeholder="name@lazy.com" />
                    <!-- 🌟 加入即時驗證的提示訊息區塊 -->
                    <div id="emailFeedback" class="small mt-1" style="display:none;"></div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-bold">密碼</label>
                    <!-- 🌟 將密碼輸入框改成 Input Group，加入眼睛按鈕 -->
                    <div class="input-group">
                        <input asp-for="Password" type="password" class="form-control" id="passwordInput" placeholder="••••••••" />
                        <button class="btn btn-outline-secondary bg-light" type="button" id="togglePassword">
                            <i class="fas fa-eye" id="toggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" id="rememberMe">
                        <label class="form-check-label text-muted small" for="rememberMe">
                            保持登入
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-login" id="submitBtn">
                    <i class="fas fa-sign-in-alt me-2"></i> 安全登入
                </button>
            </form>

            <div class="text-center mt-5 text-muted small" style="opacity: 0.6;">
                &copy; @DateTime.Now.Year LazyTravel. All rights reserved.
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- 🌟 新增：密碼顯示切換與信箱即時驗證的 JavaScript -->
    <script>
        $(document).ready(function() {
            /* --- 1. 密碼顯示/隱藏切換功能 --- */
            $("#togglePassword").click(function() {
                const passwordInput = $("#passwordInput");
                const icon = $("#toggleIcon");

                if (passwordInput.attr("type") === "password") {
                    passwordInput.attr("type", "text");
                    icon.removeClass("fa-eye").addClass("fa-eye-slash");
                } else {
                    passwordInput.attr("type", "password");
                    icon.removeClass("fa-eye-slash").addClass("fa-eye");
                }
            });

            /* --- 2. 信箱輸入即時驗證 (檢查是否包含小老鼠符號) --- */
            $("#emailInput").on("input", function() {
                const email = $(this).val();
                const feedback = $("#emailFeedback");
                const submitBtn = $("#submitBtn");

                // 如果有輸入字，但沒有包含小老鼠符號
                if (email.length > 0 && !email.includes("@@")) {
                    $(this).addClass("is-invalid").removeClass("is-valid");
                    feedback.text("請輸入包含完整網域的企業信箱格式").css("color", "#dc3545").show();
                    submitBtn.prop("disabled", true); // 格式不對禁用登入按鈕
                }
                // 如果格式正確
                else if (email.length > 0 && email.includes("@@")) {
                    $(this).removeClass("is-invalid").addClass("is-valid");
                    feedback.text("信箱格式正確").css("color", "#198754").show();
                    submitBtn.prop("disabled", false); // 啟用登入按鈕
                }
                // 清空時恢復原狀
                else {
                    $(this).removeClass("is-invalid is-valid");
                    feedback.hide();
                    submitBtn.prop("disabled", false);
                }
            });
        });
    </script>
</body>
</html>