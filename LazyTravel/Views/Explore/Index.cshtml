@model ExploreIndexViewModel
@{
    ViewData["Title"] = "找行程";
}

<style>
    /* 這頁專用的樣式，沿用 brand.css 的色彩/圓角 token，不另外套用去趣那種深色風格 */
    .explore-hero {
        background: linear-gradient(135deg, var(--sea-900), var(--sea-600));
        border-radius: 0 0 var(--radius-lg) var(--radius-lg);
        color: #fff;
    }
    .explore-hero h1 { color: #fff; }
    .explore-search .form-select,
    .explore-search .form-control {
        border-radius: var(--radius-pill);
        border: none;
        min-height: 48px;
    }
    .explore-official-badge {
        display: inline-flex;
        align-items: center;
        gap: .15rem;
        background-color: var(--coral-600);
        color: #fff;
        border-radius: var(--radius-pill);
        font-size: .72rem;
        font-weight: 500;
        padding: .1rem .6rem;
    }
    .featured-card {
        background-color: var(--surface);
        border-radius: var(--radius-lg);
        box-shadow: 0 4px 20px rgba(31, 61, 78, 0.08);
        padding: 1.5rem;
    }
    .side-card {
        display: block;
        text-decoration: none;
        color: inherit;
        background-color: var(--surface);
        border-radius: var(--radius-md);
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(31, 61, 78, 0.06);
        transition: transform .2s ease;
    }
    .side-card:hover { transform: translateY(-2px); color: inherit; }
    .side-card img { width: 100%; height: 140px; object-fit: cover; }
    .side-card .side-card-body { padding: .75rem .9rem; }
    .ranking-card {
        display: block;
        text-decoration: none;
        color: inherit;
        border-radius: var(--radius-md);
        overflow: hidden;
        background-color: var(--surface);
        box-shadow: 0 4px 16px rgba(31, 61, 78, 0.06);
        transition: transform .2s ease;
    }
    .ranking-card:hover { transform: translateY(-2px); color: inherit; }
    .ranking-img {
        height: 160px;
        background-size: cover;
        background-position: center;
        position: relative;
    }
    .ranking-badge {
        position: absolute;
        top: .6rem;
        left: .6rem;
        background-color: var(--coral-600);
        color: #fff;
        font-family: var(--font-display);
        font-size: .7rem;
        line-height: 1.1;
        text-align: center;
        border-radius: var(--radius-sm);
        padding: .25rem .5rem;
    }
    .ranking-body { padding: .75rem .9rem; }
    .ranking-location {
        display: inline-flex;
        align-items: center;
        gap: .2rem;
        font-size: .78rem;
        color: var(--text-muted);
    }
</style>

@* ---------- 搜尋區 ---------- *@
<section class="explore-hero">
    <div class="container py-5">
        <h1 class="mb-4">行程靈感</h1>

        <form method="get" asp-action="Index" class="explore-search d-flex flex-wrap gap-2">
            <select name="region" class="form-select" style="max-width:170px;" onchange="this.form.submit()">
                <option value="">找地區</option>
                @foreach (var r in Model.Regions)
                {
                    <option value="@r" selected="@(Model.Region == r)">@r</option>
                }
            </select>
            <input type="text" name="keyword" value="@Model.Keyword" class="form-control flex-grow-1"
                   style="min-width:200px;" placeholder="看看大家怎麼玩" />
            <button type="submit" class="btn btn-coral">找行程</button>
        </form>
    </div>
</section>

<div class="container">
    @if (Model.Featured is null)
    {
        <div class="text-center text-muted py-5">目前還沒有符合條件的行程，換個關鍵字試試看吧。</div>
    }
    else
    {
        @* ---------- 精選文章 + 側邊小卡片 ---------- *@
        <div class="row g-3 my-4">
            <div class="col-lg-7">
                <div class="featured-card h-100 d-flex flex-column">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="fw-medium">@MemberLookup.GetName(Model.Featured.MemberId)</span>
                        @if (MemberLookup.IsOfficial(Model.Featured.MemberId))
                        {
                            <span class="explore-official-badge">✓ 官方合作</span>
                        }
                    </div>
                    <h2 class="h4">@Model.Featured.Title</h2>
                    <p class="text-secondary flex-grow-1">@Model.FeaturedExcerpt</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Featured.MediaUrl))
                    {
                        <img src="@Model.Featured.MediaUrl" alt=""
                             style="width:100%; max-height:280px; object-fit:cover; border-radius:var(--radius-md); margin-bottom:1rem;" />
                    }
                    <a asp-action="Details" asp-route-id="@Model.Featured.PostId" class="btn btn-primary align-self-start">詳細行程</a>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="d-flex flex-column gap-3 h-100">
                    @foreach (var p in Model.SideList)
                    {
                        <a asp-action="Details" asp-route-id="@p.PostId" class="side-card d-flex flex-md-row flex-column">
                            @if (!string.IsNullOrWhiteSpace(p.MediaUrl))
                            {
                                <img src="@p.MediaUrl" alt="" style="width:100%; max-width:160px;" />
                            }
                            <div class="side-card-body">
                                <div class="text-muted small d-flex align-items-center gap-1">
                                    <span>@MemberLookup.GetName(p.MemberId)</span>
                                    @if (MemberLookup.IsOfficial(p.MemberId))
                                    {
                                        <span class="explore-official-badge">✓</span>
                                    }
                                </div>
                                <div class="fw-medium">@p.Title</div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>

        @* ---------- 人氣排行榜 ---------- *@
        @if (Model.Ranking.Any())
        {
            <section class="my-5">
                <h2 class="h4 mb-3">人氣排行榜</h2>
                <div class="row g-3">
                    @{ var rank = 1; }
                    @foreach (var p in Model.Ranking)
                    {
                        <div class="col-6 col-md-3">
                            <a asp-action="Details" asp-route-id="@p.PostId" class="ranking-card">
                                <div class="ranking-img" style="background-image:url('@p.MediaUrl')">
                                    <span class="ranking-badge">TOP<br />@rank.ToString("00")</span>
                                </div>
                                <div class="ranking-body">
                                    <span class="ranking-location">📍 @p.Destination</span>
                                    <div class="fw-medium">@p.Title</div>
                                </div>
                            </a>
                        </div>
                        rank++;
                    }
                </div>
            </section>
        }
    }
</div>
